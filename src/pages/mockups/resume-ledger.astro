---
import ResumeSwitcher from '../../components/ResumeSwitcher.astro';
import { person, roles, projects, education } from '../../data/site';

const isExec = (title: string) => /VP|Vice President|Director|Head/i.test(title);
const isAI = (summary: string, points?: string[]) =>
  /AI|LLM|agent|Claude/i.test(summary + ' ' + (points?.join(' ') ?? ''));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Résumé · Option 03 Ledger · {person.name}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="ambient" aria-hidden="true"></div>

    <header class="topbar">
      <div class="wrap topbar-inner">
        <a href="/" class="brand">{person.name}</a>
        <nav class="nav">
          <a href="/">Home</a>
          <a href="/#work">Work</a>
          <a href="/#exhibits">Exhibits</a>
          <button type="button" class="print-btn" onclick="window.print()">Print / Save PDF</button>
        </nav>
      </div>
    </header>

    <main class="wrap doc">
      <header class="doc-head">
        <div>
          <span class="kicker">Executive Résumé</span>
          <h1>{person.name}</h1>
          <p class="tagline">Engineering leadership · Moving software organizations from AI-assisted to AI-first</p>
        </div>
        <div class="contact-box">
          <a href={`mailto:${person.email}`}>{person.email}</a>
          <span>{person.location}</span>
          <div class="sub-links">
            <a href={person.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a>
            <a href={person.github} target="_blank" rel="noreferrer">GitHub ↗</a>
          </div>
        </div>
      </header>

      <section class="summary-strip">
        <p>
          Engineering executive with 17 years leading teams and 19 years shipping production software. Currently Director
          of Software Development at Second Nature, building and rolling out a verification-heavy software factory.
          Previously VP of Software Development at Rev, leading a 60-person organization across AI, SaaS and mobile,
          including the #1 G2-ranked legal AI assistant.
        </p>
      </section>

      <!-- FILTER BAR -->
      <div class="toolbar">
        <div class="filters" role="group" aria-label="Filter roles">
          <button type="button" class="f-btn active" data-filter="all">All Roles ({roles.length})</button>
          <button type="button" class="f-btn" data-filter="exec">VP &amp; Director</button>
          <button type="button" class="f-btn" data-filter="ai">AI &amp; Agentic Delivery</button>
        </div>
        <button type="button" class="toggle-btn" id="toggle-details">Compact view</button>
      </div>

      <!-- LEDGER TABLE -->
      <section class="ledger" id="ledger">
        {
          roles.map((r) => (
            <article
              class="l-row"
              data-exec={isExec(r.title) ? '1' : '0'}
              data-ai={isAI(r.summary, r.points) ? '1' : '0'}
            >
              <div class="l-when">
                <strong>{r.start} – {r.end}</strong>
                <span>{r.place}</span>
              </div>
              <div class="l-body">
                <h3>
                  {r.title} <span class="at">@ {r.company}</span>
                </h3>
                <p class="l-sum">{r.summary}</p>
                {r.points && (
                  <ul class="l-pts">
                    {r.points.map((pt) => (
                      <li>{pt}</li>
                    ))}
                  </ul>
                )}
              </div>
              <div class="l-stack">{r.stack && <span>{r.stack}</span>}</div>
            </article>
          ))
        }
      </section>

      <!-- BOTTOM 2-COL -->
      <section class="foot-grid">
        <div class="foot-card">
          <span class="kicker">Education</span>
          {
            education.map((e) => (
              <div class="foot-item">
                <strong>{e.degree}</strong>
                <span>{e.school} · {e.when}</span>
              </div>
            ))
          }
          <div class="foot-item also">
            <strong>Also</strong>
            <span>Private pilot · Competitive hockey · English, French, Spanish</span>
          </div>
        </div>

        <div class="foot-card">
          <span class="kicker">Selected Projects</span>
          {
            projects.map((p) => (
              <div class="foot-item">
                <strong>{p.name} ({p.years})</strong>
                <span>{p.blurb.split('. ')[0]}.</span>
              </div>
            ))
          }
        </div>
      </section>
    </main>

    <ResumeSwitcher active="ledger" />

    <script>
      const rows = [...document.querySelectorAll<HTMLElement>('.l-row')];
      const fBtns = [...document.querySelectorAll<HTMLButtonElement>('.f-btn')];
      fBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          fBtns.forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          const f = btn.dataset.filter;
          rows.forEach((row) => {
            const show =
              f === 'all' || (f === 'exec' && row.dataset.exec === '1') || (f === 'ai' && row.dataset.ai === '1');
            row.style.display = show ? '' : 'none';
          });
        });
      });

      const toggleBtn = document.getElementById('toggle-details');
      const ledger = document.getElementById('ledger');
      toggleBtn?.addEventListener('click', () => {
        const compact = ledger?.classList.toggle('compact');
        if (toggleBtn) toggleBtn.textContent = compact ? 'Detailed view' : 'Compact view';
      });
    </script>
  </body>
</html>

<style>
  :root {
    --bg: #090a0d;
    --bg-2: #11131a;
    --ink: #f1f5f9;
    --ink-2: #cbd5e1;
    --muted: #94a3b8;
    --rule: rgba(255, 255, 255, 0.1);
    --accent: #38bdf8;
    --accent-2: #818cf8;
    --mono: 'JetBrains Mono', monospace;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    line-height: 1.6;
    padding-bottom: 6rem;
  }
  .ambient {
    position: fixed;
    inset: -15% -10% auto -10%;
    height: 70vh;
    background:
      radial-gradient(55% 50% at 18% 18%, rgba(99, 102, 241, 0.12), transparent 70%),
      radial-gradient(50% 50% at 84% 12%, rgba(56, 189, 248, 0.1), transparent 70%);
    pointer-events: none;
  }
  .wrap {
    max-width: 72rem;
    margin: 0 auto;
    padding-inline: 2rem;
    position: relative;
    z-index: 1;
  }
  .topbar {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(9, 10, 13, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--rule);
  }
  .topbar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 3.8rem;
  }
  .brand {
    color: #fff;
    font-weight: 800;
    text-decoration: none;
    font-size: 1.1rem;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    font-size: 0.9rem;
  }
  .nav a {
    color: var(--muted);
    text-decoration: none;
  }
  .nav a:hover {
    color: var(--accent);
  }
  .print-btn {
    padding: 0.45rem 0.9rem;
    border-radius: 8px;
    border: 1px solid rgba(56, 189, 248, 0.4);
    background: rgba(56, 189, 248, 0.12);
    color: var(--accent);
    font: 600 0.82rem inherit;
    cursor: pointer;
  }
  .print-btn:hover {
    background: var(--accent);
    color: #090a0d;
  }

  .doc {
    padding-top: 2.5rem;
  }
  .kicker {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--accent);
    display: block;
    margin-bottom: 0.35rem;
  }

  .doc-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--rule);
  }
  h1 {
    margin: 0;
    font-size: 2.4rem;
    letter-spacing: -0.03em;
  }
  .tagline {
    margin: 0.2rem 0 0;
    color: var(--ink-2);
    font-size: 1.02rem;
  }
  .contact-box {
    text-align: right;
    font-family: var(--mono);
    font-size: 0.78rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .contact-box a {
    color: var(--accent);
    text-decoration: none;
  }
  .contact-box span {
    color: var(--muted);
  }
  .sub-links {
    display: flex;
    gap: 0.75rem;
    justify-content: flex-end;
  }

  .summary-strip {
    padding-block: 1.35rem;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 1.5rem;
  }
  .summary-strip p {
    margin: 0;
    color: var(--muted);
    max-width: 58rem;
  }

  .toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }
  .filters {
    display: flex;
    gap: 0.45rem;
    flex-wrap: wrap;
  }
  .f-btn,
  .toggle-btn {
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--rule);
    background: var(--bg-2);
    color: var(--muted);
    font: 500 0.82rem inherit;
    cursor: pointer;
  }
  .f-btn:hover,
  .toggle-btn:hover {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.25);
  }
  .f-btn.active {
    background: rgba(56, 189, 248, 0.14);
    border-color: rgba(56, 189, 248, 0.45);
    color: var(--accent);
    font-weight: 600;
  }

  .ledger {
    border-top: 2px solid rgba(255, 255, 255, 0.2);
    margin-bottom: 2.5rem;
  }
  .l-row {
    display: grid;
    grid-template-columns: 11rem 1fr 14rem;
    gap: 1.5rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--rule);
    align-items: start;
  }
  .l-when strong {
    display: block;
    font-family: var(--mono);
    font-size: 0.76rem;
    color: var(--accent);
    font-weight: 500;
  }
  .l-when span {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .l-body h3 {
    margin: 0 0 0.35rem;
    font-size: 1.05rem;
    color: #fff;
  }
  .at {
    color: var(--ink-2);
    font-weight: 500;
  }
  .l-sum {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .l-pts {
    margin: 0.65rem 0 0;
    padding-left: 1.15rem;
    color: var(--ink-2);
    font-size: 0.88rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .ledger.compact .l-pts {
    display: none;
  }
  .l-stack span {
    font-family: var(--mono);
    font-size: 0.74rem;
    color: var(--accent-2);
    display: block;
    text-align: right;
  }

  .foot-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .foot-card {
    background: var(--bg-2);
    border: 1px solid var(--rule);
    border-radius: 16px;
    padding: 1.5rem;
  }
  .foot-item {
    margin-top: 0.85rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--rule);
  }
  .foot-item:first-of-type {
    border-top: 0;
    padding-top: 0;
  }
  .foot-item strong {
    display: block;
    font-size: 0.94rem;
    color: #fff;
  }
  .foot-item span {
    font-size: 0.86rem;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .doc-head,
    .l-row,
    .foot-grid {
      grid-template-columns: 1fr;
      flex-direction: column;
      align-items: flex-start;
    }
    .contact-box,
    .l-stack span {
      text-align: left;
    }
    .sub-links {
      justify-content: flex-start;
    }
    .l-row {
      gap: 0.5rem;
    }
  }

  @media print {
    body {
      background: #fff;
      color: #111;
      padding: 0;
    }
    .ambient,
    .topbar,
    .toolbar {
      display: none;
    }
    .foot-card {
      background: #fff;
      border-color: #ddd;
    }
    .l-body h3,
    .foot-item strong {
      color: #111;
    }
    .summary-strip p,
    .l-sum,
    .l-pts,
    .foot-item span {
      color: #333;
    }
  }
</style>
