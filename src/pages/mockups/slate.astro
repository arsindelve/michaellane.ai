---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import portrait from '../../assets/me.jpeg';
import MockupSwitcher from '../../components/MockupSwitcher.astro';
import { person, roles, principles, education } from '../../data/site';

const all = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const work = all.filter((e) => e.data.kind === 'work');
const exhibits = all.filter((e) => e.data.kind === 'exhibit' && e.id !== 'this-site');

const kpis = [
  { value: '60+', label: 'Engineers, AI, QA & Design led' },
  { value: '#1 G2', label: 'AI Legal Assistant (Summer 2025)' },
  { value: '2×', label: 'Velocity in AI-first pilot pods' },
  { value: '4.0 GPA', label: 'MBA · MSc AI in progress' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Executive Slate · {person.name}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="ambient" aria-hidden="true"></div>

    <header class="topbar">
      <div class="wrap topbar-inner">
        <a href="/mockups/slate" class="brand">
          <span class="brand-mark">ML</span>
          <span>{person.name}</span>
        </a>
        <nav class="nav">
          <a href="#leadership">Leadership</a>
          <a href="#principles">Principles</a>
          <a href="#lab">AI Lab</a>
          <a href="#career">Career</a>
          <a href="/resume" class="nav-pill">Résumé</a>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <!-- HERO -->
      <section class="hero">
        <div class="hero-copy">
          <div class="status-pill">
            <span class="dot"></span>
            <span>{person.status} · {person.location}</span>
          </div>
          <h1>
            Engineering leader building <span class="grad">AI-first organizations</span> that ship.
          </h1>
          <p class="lede">
            I’ve led 60+ person organizations across product engineering, AI research, QA, and design. Today I’m
            architecting verification-heavy software factories—and still writing, breaking, and researching AI systems
            on my own time.
          </p>
          <div class="hero-actions">
            <a href="#leadership" class="btn-primary">Explore Case Studies ↓</a>
            <a href={`mailto:${person.email}`} class="btn-ghost">Get in touch</a>
            <a href={person.linkedin} class="btn-ghost" target="_blank" rel="noreferrer">LinkedIn ↗</a>
          </div>
        </div>

        <aside class="hero-card">
          <div class="portrait-wrap">
            <Image src={portrait} alt={person.name} width={520} height={520} class="portrait" />
            <div class="portrait-overlay">
              <span class="mono-tag">CURRENTLY</span>
              <strong>Director of Software Development</strong>
              <span>Second Nature · 3 teams, 22 engineers &amp; QA</span>
            </div>
          </div>
        </aside>
      </section>

      <!-- KPI STRIP -->
      <section class="kpi-strip" aria-label="Key career metrics">
        {
          kpis.map((k) => (
            <div class="kpi">
              <span class="kpi-val">{k.value}</span>
              <span class="kpi-lbl">{k.label}</span>
            </div>
          ))
        }
      </section>

      <!-- LEADERSHIP CASE STUDIES -->
      <section id="leadership" class="section">
        <div class="sec-head">
          <p class="eyebrow">01 · Selected Leadership</p>
          <h2>Work I’ve led</h2>
          <p class="sec-sub">Production platforms, AI transformations, and multi-team organizations.</p>
        </div>

        <div class="work-grid">
          {
            work.map((w, idx) => {
              const thumb = w.data.cover ?? w.data.slides?.[0]?.src;
              const thumbAlt = w.data.coverAlt ?? w.data.slides?.[0]?.alt ?? w.data.title;
              return (
                <a href={`/work/${w.id}`} class:list={['work-card', { featured: idx < 2 }]}>
                  {thumb && (
                    <div class="work-media">
                      <Image src={thumb} alt={thumbAlt} width={900} class="work-img" />
                    </div>
                  )}
                  <div class="work-body">
                    <div class="work-meta">
                      <span class="mono-tag">{w.data.years}</span>
                      <span class="role-tag">{w.data.role}</span>
                    </div>
                    <h3>{w.data.title}</h3>
                    <p class="work-kicker">{w.data.kicker}</p>
                    <p class="work-summary">{w.data.summary}</p>
                    {w.data.stats.length > 0 && (
                      <div class="work-stats">
                        {w.data.stats.slice(0, 2).map((s) => (
                          <div class="ws">
                            <strong>{s.n}</strong>
                            <span>{s.label}</span>
                          </div>
                        ))}
                      </div>
                    )}
                    <span class="read-more">Read case study →</span>
                  </div>
                </a>
              );
            })
          }
        </div>
      </section>

      <!-- PRINCIPLES -->
      <section id="principles" class="section">
        <div class="sec-head">
          <p class="eyebrow">02 · Operating Philosophy</p>
          <h2>How I lead engineering</h2>
        </div>
        <div class="principles-grid">
          {
            principles.map((p, i) => (
              <article class="principle-card">
                <span class="p-num">0{i + 1}</span>
                <h3>{p.head}</h3>
                <p>{p.body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <!-- AI LAB / EXHIBITS -->
      <section id="lab" class="section">
        <div class="sec-head">
          <p class="eyebrow">03 · Independent AI &amp; R&amp;D</p>
          <h2>Built on my own time</h2>
          <p class="sec-sub">
            Long-horizon LLM agents, adversarial playtesters, and faithful modern ports of 1980s–90s worlds.
          </p>
        </div>

        <div class="lab-grid">
          {
            exhibits.map((ex) => {
              const thumb = ex.data.cover ?? ex.data.slides?.[0]?.src;
              const thumbAlt = ex.data.coverAlt ?? ex.data.slides?.[0]?.alt ?? ex.data.title;
              return (
                <a href={`/work/${ex.id}`} class="lab-card">
                  {thumb ? (
                    <div class="lab-media">
                      <Image src={thumb} alt={thumbAlt} width={720} class="lab-img" />
                    </div>
                  ) : (
                    <div class="lab-media lab-placeholder">
                      <span>{ex.data.stack.slice(0, 3).join(' · ')}</span>
                    </div>
                  )}
                  <div class="lab-body">
                    <div class="lab-top">
                      <h3>{ex.data.title}</h3>
                      <span class="mono-tag">{ex.data.years}</span>
                    </div>
                    <p>{ex.data.kicker}</p>
                    <div class="chips">
                      {ex.data.stack.slice(0, 3).map((t) => (
                        <span>{t}</span>
                      ))}
                    </div>
                  </div>
                </a>
              );
            })
          }
        </div>
      </section>

      <!-- CAREER & EDUCATION -->
      <section id="career" class="section">
        <div class="sec-head">
          <p class="eyebrow">04 · Track Record &amp; Credentials</p>
          <h2>Career &amp; Education</h2>
        </div>

        <div class="two-col">
          <div class="timeline">
            {
              roles.slice(0, 7).map((r) => (
                <div class="tl-row">
                  <div class="tl-dates">
                    <span>{r.start} – {r.end}</span>
                    <small>{r.place}</small>
                  </div>
                  <div class="tl-info">
                    <strong>{r.title}</strong> · <span class="company">{r.company}</span>
                    <p>{r.summary}</p>
                  </div>
                </div>
              ))
            }
            <a href="/resume" class="all-roles">View full 11-role résumé →</a>
          </div>

          <div class="edu-col">
            {
              education.map((e) => (
                <div class="edu-card">
                  <span class="mono-tag">{e.when}</span>
                  <h3>{e.degree}</h3>
                  <p class="school">{e.school}</p>
                  {'note' in e && e.note && <p class="edu-note">{e.note}</p>}
                </div>
              ))
            }

            <div class="contact-card">
              <span class="mono-tag">DIRECT CONTACT</span>
              <h3>Let’s talk engineering leadership.</h3>
              <p>Open to VP / Director of Engineering roles and AI-first transformation leadership.</p>
              <div class="contact-links">
                <a href={`mailto:${person.email}`}>{person.email}</a>
                <a href={person.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a>
                <a href={person.github} target="_blank" rel="noreferrer">GitHub ↗</a>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <MockupSwitcher active="slate" />
  </body>
</html>

<style>
  :root {
    --bg: #090a0d;
    --surface: #11131a;
    --surface-2: #161923;
    --border: rgba(255, 255, 255, 0.09);
    --border-hi: rgba(99, 102, 241, 0.45);
    --text: #f1f5f9;
    --muted: #94a3b8;
    --dim: #64748b;
    --accent: #38bdf8;
    --indigo: #818cf8;
  }
  * {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    line-height: 1.6;
    padding-bottom: 6rem;
    position: relative;
    overflow-x: hidden;
  }
  .ambient {
    position: fixed;
    inset: -20% -10% auto -10%;
    height: 70vh;
    background:
      radial-gradient(60% 55% at 20% 20%, rgba(99, 102, 241, 0.14), transparent 70%),
      radial-gradient(50% 50% at 80% 10%, rgba(56, 189, 248, 0.11), transparent 70%);
    pointer-events: none;
    z-index: 0;
  }
  .wrap {
    max-width: 74rem;
    margin: 0 auto;
    padding-inline: 2rem;
    position: relative;
    z-index: 1;
  }
  .topbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(9, 10, 13, 0.78);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
  }
  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4.25rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }
  .brand-mark {
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 8px;
    background: linear-gradient(135deg, #6366f1, #38bdf8);
    color: #090a0d;
    display: grid;
    place-items: center;
    font-size: 0.78rem;
    font-weight: 800;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    font-size: 0.9rem;
    font-weight: 500;
  }
  .nav a {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s;
  }
  .nav a:hover {
    color: #fff;
  }
  .nav-pill {
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: #fff !important;
  }

  /* HERO */
  .hero {
    display: grid;
    grid-template-columns: 1.35fr 0.85fr;
    gap: 3.5rem;
    align-items: center;
    padding-block: 4.5rem 3.5rem;
  }
  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: rgba(56, 189, 248, 0.08);
    border: 1px solid rgba(56, 189, 248, 0.25);
    color: #bae6fd;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    margin-bottom: 1.5rem;
  }
  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #34d399;
    box-shadow: 0 0 0 4px rgba(52, 211, 153, 0.18);
  }
  h1 {
    font-size: clamp(2.4rem, 4.6vw, 3.75rem);
    line-height: 1.07;
    letter-spacing: -0.035em;
    font-weight: 800;
    margin: 0 0 1.25rem;
    color: #fff;
  }
  .grad {
    background: linear-gradient(120deg, #38bdf8, #a5b4fc);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .lede {
    font-size: 1.125rem;
    color: var(--muted);
    max-width: 38rem;
    margin: 0 0 2rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .btn-primary {
    padding: 0.8rem 1.3rem;
    border-radius: 10px;
    background: #fff;
    color: #090a0d;
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
    transition: transform 0.15s, background 0.15s;
  }
  .btn-primary:hover {
    background: var(--accent);
    transform: translateY(-1px);
  }
  .btn-ghost {
    padding: 0.8rem 1.15rem;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
    transition: border-color 0.15s;
  }
  .btn-ghost:hover {
    border-color: rgba(255, 255, 255, 0.3);
  }

  .hero-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 0.75rem;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
  }
  .portrait-wrap {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    aspect-ratio: 4 / 4.3;
  }
  .portrait {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .portrait-overlay {
    position: absolute;
    inset: auto 0 0 0;
    padding: 1.25rem;
    background: linear-gradient(to top, rgba(9, 10, 13, 0.94) 15%, rgba(9, 10, 13, 0.55) 70%, transparent);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .portrait-overlay strong {
    color: #fff;
    font-size: 1rem;
  }
  .portrait-overlay span:last-child {
    color: #cbd5e1;
    font-size: 0.82rem;
  }

  /* KPI STRIP */
  .kpi-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    margin-bottom: 5rem;
  }
  .kpi {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-inline: 0.5rem;
  }
  .kpi-val {
    font-size: 1.85rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #fff;
    line-height: 1.1;
  }
  .kpi-lbl {
    font-size: 0.82rem;
    color: var(--muted);
  }

  /* SECTIONS */
  .section {
    margin-bottom: 5.5rem;
  }
  .sec-head {
    margin-bottom: 2.25rem;
  }
  .eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.5rem;
  }
  h2 {
    font-size: clamp(1.75rem, 3vw, 2.35rem);
    letter-spacing: -0.03em;
    margin: 0 0 0.4rem;
    color: #fff;
  }
  .sec-sub {
    color: var(--muted);
    margin: 0;
  }
  .mono-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }

  /* WORK GRID */
  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .work-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 18px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s, transform 0.2s;
  }
  .work-card:hover {
    border-color: var(--border-hi);
    transform: translateY(-3px);
  }
  .work-media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #0d0f14;
    border-bottom: 1px solid var(--border);
  }
  .work-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }
  .work-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .work-meta {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
    flex-wrap: wrap;
  }
  .role-tag {
    font-size: 0.78rem;
    color: var(--muted);
  }
  .work-body h3 {
    font-size: 1.3rem;
    letter-spacing: -0.02em;
    color: #fff;
    margin: 0 0 0.35rem;
  }
  .work-kicker {
    color: #cbd5e1;
    font-size: 0.92rem;
    font-weight: 500;
    margin: 0 0 0.75rem;
  }
  .work-summary {
    color: var(--muted);
    font-size: 0.88rem;
    margin: 0 0 1.25rem;
    flex: 1;
  }
  .work-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    padding: 0.85rem;
    background: var(--surface-2);
    border-radius: 10px;
    margin-bottom: 1.1rem;
  }
  .ws strong {
    display: block;
    font-size: 1.15rem;
    color: #fff;
  }
  .ws span {
    font-size: 0.75rem;
    color: var(--muted);
    line-height: 1.3;
    display: block;
  }
  .read-more {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
  }

  /* PRINCIPLES */
  .principles-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .principle-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.6rem;
  }
  .p-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
    color: var(--indigo);
    display: block;
    margin-bottom: 0.65rem;
  }
  .principle-card h3 {
    font-size: 1.12rem;
    color: #fff;
    margin: 0 0 0.5rem;
    letter-spacing: -0.015em;
  }
  .principle-card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  /* LAB */
  .lab-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .lab-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s, transform 0.2s;
  }
  .lab-card:hover {
    border-color: var(--border-hi);
    transform: translateY(-2px);
  }
  .lab-media {
    aspect-ratio: 16 / 10;
    background: #0d0f14;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .lab-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .lab-placeholder {
    display: grid;
    place-items: center;
    padding: 1rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
    color: var(--muted);
    text-align: center;
  }
  .lab-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .lab-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }
  .lab-body h3 {
    font-size: 1.1rem;
    color: #fff;
    margin: 0;
  }
  .lab-body p {
    font-size: 0.86rem;
    color: var(--muted);
    margin: 0 0 1rem;
    flex: 1;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .chips span {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    background: var(--surface-2);
    color: #cbd5e1;
    border: 1px solid var(--border);
  }

  /* CAREER & EDU */
  .two-col {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: 2.5rem;
    align-items: start;
  }
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .tl-row {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    gap: 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }
  .tl-dates span {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.76rem;
    color: var(--accent);
    display: block;
  }
  .tl-dates small {
    font-size: 0.78rem;
    color: var(--dim);
  }
  .tl-info strong {
    color: #fff;
  }
  .tl-info .company {
    color: #cbd5e1;
  }
  .tl-info p {
    margin: 0.3rem 0 0;
    font-size: 0.88rem;
    color: var(--muted);
  }
  .all-roles {
    color: var(--accent);
    text-decoration: none;
