---
import { Image } from 'astro:assets';
import portrait from '../../assets/me.jpeg';
import { person } from '../../data/site';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Contact Card Mockups · {person.name}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="ambient" aria-hidden="true"></div>

    <main class="page">
      <header class="head">
        <p class="eyebrow">Obsidian · Contact Card Options</p>
        <h1>Four ways to frame the Contact section</h1>
        <p class="sub">Each option keeps your email + Copy button, availability status, LinkedIn, GitHub, and Résumé.</p>
      </header>

      <div class="stack">
        <!-- OPTION 1: EXECUTIVE PORTRAIT SPLIT -->
        <section class="opt">
          <div class="opt-meta">
            <span class="tag">Option 01</span>
            <h2>Executive Portrait Split</h2>
            <p>Pairs your headshot and availability status with a structured email + action-tile grid.</p>
          </div>
          <div class="c1">
            <div class="c1-left">
              <div class="c1-id">
                <Image src={portrait} alt={person.name} width={128} height={128} class="c1-avatar" />
                <div>
                  <span class="pill"><i class="dot" /> {person.status}</span>
                  <h3>Let’s talk engineering leadership.</h3>
                  <p>{person.location} · VP &amp; Director roles · AI-first engineering</p>
                </div>
              </div>
            </div>
            <div class="c1-right">
              <div class="c1-email-box">
                <span class="mono-lbl">Direct Email</span>
                <div class="c1-email-row">
                  <a href={`mailto:${person.email}`}>{person.email}</a>
                  <button type="button" class="copy-btn" data-email={person.email}>Copy</button>
                </div>
              </div>
              <div class="c1-tiles">
                <a href={person.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a>
                <a href={person.github} target="_blank" rel="noreferrer">GitHub ↗</a>
                <a href="/resume">Résumé →</a>
              </div>
            </div>
          </div>
        </section>

        <!-- OPTION 2: WEST OF HOUSE TERMINAL CARD -->
        <section class="opt">
          <div class="opt-meta">
            <span class="tag">Option 02</span>
            <h2>“West of House” Terminal Card</h2>
            <p>Nods to the Infocom room theme while staying crisp, modern, and executive-ready.</p>
          </div>
          <div class="c2">
            <div class="c2-bar">
              <span class="c2-room">&gt; west of house · contact</span>
              <span class="c2-loc">{person.location}</span>
            </div>
            <div class="c2-body">
              <h3>There is a small mailbox here.</h3>
              <p>
                Inside is a direct line to {person.name}. {person.status}.
              </p>
              <div class="c2-actions">
                <a href={`mailto:${person.email}`} class="btn-cyan">{person.email}</a>
                <button type="button" class="copy-btn" data-email={person.email}>Copy address</button>
              </div>
              <div class="c2-cmds">
                <a href={person.linkedin} target="_blank" rel="noreferrer">&gt; open linkedin ↗</a>
                <a href={person.github} target="_blank" rel="noreferrer">&gt; open github ↗</a>
                <a href="/resume">&gt; examine résumé →</a>
              </div>
            </div>
          </div>
        </section>

        <!-- OPTION 3: MINIMAL ASYMMETRIC BANNER -->
        <section class="opt">
          <div class="opt-meta">
            <span class="tag">Option 03</span>
            <h2>Minimal Asymmetric Banner</h2>
            <p>High-contrast typographic focus on your email address with stacked right-hand links.</p>
          </div>
          <div class="c3">
            <div class="c3-main">
              <span class="mono-lbl">Contact · {person.location}</span>
              <div class="c3-email-wrap">
                <a href={`mailto:${person.email}`} class="c3-email">{person.email}</a>
                <button type="button" class="copy-btn" data-email={person.email}>Copy</button>
              </div>
              <p class="c3-status"><i class="dot" /> {person.status}</p>
            </div>
            <nav class="c3-links" aria-label="Contact links">
              <a href={person.linkedin} target="_blank" rel="noreferrer">
                <span>LinkedIn</span>
                <span>↗</span>
              </a>
              <a href={person.github} target="_blank" rel="noreferrer">
                <span>GitHub</span>
                <span>↗</span>
              </a>
              <a href="/resume">
                <span>Full Résumé</span>
                <span>→</span>
              </a>
            </nav>
          </div>
        </section>

        <!-- OPTION 4: BENTO ACTION CLUSTER -->
        <section class="opt">
          <div class="opt-meta">
            <span class="tag">Option 04</span>
            <h2>Bento Action Grid</h2>
            <p>Modular 4-tile cluster with a hero email tile and three equal-width profile cards below.</p>
          </div>
          <div class="c4">
            <div class="c4-hero">
              <div>
                <span class="mono-lbl">Say Hello</span>
                <h3>{person.email}</h3>
                <p>{person.status} · {person.location}</p>
              </div>
              <div class="c4-btns">
                <a href={`mailto:${person.email}`} class="btn-white">Send Email</a>
                <button type="button" class="copy-btn" data-email={person.email}>Copy</button>
              </div>
            </div>
            <div class="c4-grid">
              <a href={person.linkedin} target="_blank" rel="noreferrer" class="c4-tile">
                <strong>LinkedIn ↗</strong>
                <span>/in/michaelnlane</span>
              </a>
              <a href={person.github} target="_blank" rel="noreferrer" class="c4-tile">
                <strong>GitHub ↗</strong>
                <span>@arsindelve</span>
              </a>
              <a href="/resume" class="c4-tile">
                <strong>Full Résumé →</strong>
                <span>17 yrs · 11 roles</span>
              </a>
            </div>
          </div>
        </section>
      </div>
    </main>

    <script>
      document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
        let timer: number | undefined;
        btn.addEventListener('click', async () => {
          const email = btn.dataset.email;
          if (!email) return;
          const orig = btn.textContent;
          try {
            await navigator.clipboard.writeText(email);
            btn.textContent = 'Copied!';
          } catch {
            btn.textContent = email;
          }
          clearTimeout(timer);
          timer = window.setTimeout(() => (btn.textContent = orig), 1800);
        });
      });
    </script>
  </body>
</html>

<style>
  :root {
    --bg: #090a0d;
    --bg-2: #11131a;
    --surface-2: #171a24;
    --ink: #f1f5f9;
    --ink-2: #cbd5e1;
    --muted: #94a3b8;
    --rule: rgba(255, 255, 255, 0.1);
    --accent: #38bdf8;
    --accent-2: #818cf8;
    --mono: 'JetBrains Mono', monospace;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    line-height: 1.55;
  }
  .ambient {
    position: fixed;
    inset: -15% -10% auto -10%;
    height: 70vh;
    background:
      radial-gradient(55% 50% at 18% 18%, rgba(99, 102, 241, 0.12), transparent 70%),
      radial-gradient(50% 50% at 84% 12%, rgba(56, 189, 248, 0.1), transparent 70%);
    pointer-events: none;
  }
  .page {
    max-width: 68rem;
    margin: 0 auto;
    padding: 3.5rem 2rem 6rem;
    position: relative;
    z-index: 1;
  }
  .head {
    max-width: 42rem;
    margin-bottom: 3rem;
  }
  .eyebrow,
  .tag,
  .mono-lbl {
    font-family: var(--mono);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    display: block;
  }
  h1 {
    margin: 0.4rem 0 0.6rem;
    font-size: 2.2rem;
    letter-spacing: -0.03em;
  }
  .sub {
    margin: 0;
    color: var(--muted);
  }
  .stack {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  .opt-meta {
    margin-bottom: 1rem;
  }
  .opt-meta h2 {
    margin: 0.2rem 0 0.2rem;
    font-size: 1.25rem;
  }
  .opt-meta p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .copy-btn {
    padding: 0.45rem 0.85rem;
    border-radius: 8px;
    border: 1px solid var(--rule);
    background: var(--surface-2);
    color: var(--ink);
    font: 600 0.82rem inherit;
    cursor: pointer;
  }
  .copy-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #34d399;
    display: inline-block;
  }

  /* OPTION 1 */
  .c1 {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 1.5rem;
    background: linear-gradient(145deg, rgba(99, 102, 241, 0.1), var(--bg-2));
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 20px;
    padding: 2rem;
    align-items: center;
  }
  .c1-id {
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }
  .c1-avatar {
    width: 4.75rem;
    height: 4.75rem;
    border-radius: 16px;
    object-fit: cover;
    border: 1px solid var(--rule);
    flex: none;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: #a7f3d0;
    margin-bottom: 0.4rem;
  }
  .c1-id h3 {
    margin: 0 0 0.25rem;
    font-size: 1.35rem;
  }
  .c1-id p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--muted);
  }
  .c1-email-box {
    background: var(--surface-2);
    border: 1px solid var(--rule);
    border-radius: 12px;
    padding: 0.9rem 1.1rem;
    margin-bottom: 0.75rem;
  }
  .c1-email-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }
  .c1-email-row a {
    color: #fff;
    font-weight: 700;
    text-decoration: none;
    font-size: 1.02rem;
  }
  .c1-tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
  }
  .c1-tiles a {
    text-align: center;
    padding: 0.6rem 0.5rem;
    border-radius: 10px;
    background: var(--bg-2);
    border: 1px solid var(--rule);
    color: var(--ink-2);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .c1-tiles a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* OPTION 2 */
  .c2 {
    background: var(--bg-2);
    border: 1px solid var(--rule);
    border-radius: 18px;
    overflow: hidden;
  }
  .c2-bar {
    display: flex;
    justify-content: space-between;
    padding: 0.65rem 1.4rem;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: 0.75rem;
  }
  .c2-room {
    color: var(--accent);
  }
  .c2-loc {
    color: var(--muted);
  }
  .c2-body {
    padding: 2rem;
  }
  .c2-body h3 {
    margin: 0 0 0.35rem;
    font-size: 1.45rem;
  }
  .c2-body p {
    margin: 0 0 1.4rem;
    color: var(--muted);
  }
  .c2-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }
  .btn-cyan {
    padding: 0.65rem 1.15rem;
    border-radius: 10px;
    background: var(--accent);
    color: #090a0d;
    font-weight: 700;
    text-decoration: none;
    font-size: 0.92rem;
  }
  .c2-cmds {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: 0.82rem;
  }
  .c2-cmds a {
    color: var(--ink-2);
    text-decoration: none;
  }
  .c2-cmds a:hover {
    color: var(--accent);
  }

  /* OPTION 3 */
  .c3 {
    display: grid;
    grid-template-columns: 1.4fr 0.75fr;
    gap: 2rem;
    background: var(--bg-2);
    border: 1px solid var(--rule);
    border-radius: 20px;
    padding: 2.25rem;
    align-items: center;
  }
  .c3-email-wrap {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 0.6rem 0 0.9rem;
  }
  .c3-email {
    font-size: clamp(1.35rem, 2.8vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #fff;
    text-decoration: none;
  }
  .c3-email:hover {
    color: var(--accent);
  }
  .c3-status {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .c3-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .c3-links a {
    display: flex;
    justify-content: space-between;
    padding: 0.7rem 1rem;
    border-radius: 10px;
    background: var(--surface-2);
    border: 1px solid var(--rule);
    color: var(--ink-2);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.92rem;
  }
  .c3-links a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* OPTION 4 */
  .c4 {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .c4-hero {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    background: linear-gradient(135deg, rgba(56, 189, 248, 0.12), var(--bg-2));
    border: 1px solid rgba(56, 189, 248, 0.35);
    border-radius: 18px;
    padding: 1.75rem 2rem;
  }
  .c4-hero h3 {
    margin: 0.25rem 0 0.2rem;
    font-size: 1.45rem;
  }
  .c4-hero p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .c4-btns {
    display: flex;
    gap: 0.6rem;
    flex-shrink: 0;
  }
  .btn-white {
    padding: 0.55rem 1.05rem;
    border-radius: 8px;
    background: #fff;
    color: #090a0d;
    font-weight: 700;
    font-size: 0.88rem;
    text-decoration: none;
  }
  .btn-white:hover {
    background: var(--accent);
  }
  .c4-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
  }
  .c4-tile {
    background: var(--bg-2);
    border: 1px solid var(--rule);
    border-radius: 14px;
    padding: 1.15rem 1.35rem;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .c4-tile:hover {
    border-color: var(--accent);
  }
  .c4-tile strong {
    color: #fff;
    font-size: 1rem;
  }
  .c4-tile span {
    font-family: var(--mono);
    font-size: 0.76rem;
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .c1,
    .c3,
    .c4-grid {
      grid-template-columns: 1fr;
    }
    .c4-hero {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
