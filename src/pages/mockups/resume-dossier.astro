---
import { Image } from 'astro:assets';
import portrait from '../../assets/me.jpeg';
import ResumeSwitcher from '../../components/ResumeSwitcher.astro';
import { person, roles, projects, education } from '../../data/site';

const kpis = [
  { n: '17 yrs', l: 'Leading engineering teams' },
  { n: '60+', l: 'Org scale at Rev' },
  { n: '#1 G2', l: 'AI Legal Assistant' },
  { n: '4.0 GPA', l: 'MBA · MSc AI in progress' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Résumé · Option 01 Dossier · {person.name}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="ambient" aria-hidden="true"></div>

    <header class="topbar">
      <div class="wrap topbar-inner">
        <a href="/" class="brand">{person.name}</a>
        <nav class="nav">
          <a href="/">Home</a>
          <a href="/#work">Work</a>
          <a href="/#exhibits">Exhibits</a>
          <button type="button" class="print-btn" onclick="window.print()">Print / Save PDF</button>
        </nav>
      </div>
    </header>

    <div class="wrap shell">
      <!-- STICKY LEFT DOSSIER -->
      <aside class="rail">
        <div class="id-card">
          <Image src={portrait} alt={person.name} width={160} height={160} class="avatar" />
          <h1>{person.name}</h1>
          <p class="role">{person.title}</p>
          <p class="loc">{person.location}</p>
          <div class="status">
            <span class="dot"></span>
            {person.status}
          </div>
        </div>

        <div class="rail-sec">
          <h2>Contact</h2>
          <ul class="contact-list">
            <li><a href={`mailto:${person.email}`}>{person.email}</a></li>
            <li><a href={person.linkedin} target="_blank" rel="noreferrer">linkedin.com/in/michaelnlane ↗</a></li>
            <li><a href={person.github} target="_blank" rel="noreferrer">github.com/arsindelve ↗</a></li>
          </ul>
        </div>

        <div class="rail-sec">
          <h2>Education</h2>
          {
            education.map((e) => (
              <div class="edu-item">
                <strong>{e.degree}</strong>
                <span>{e.school}</span>
                <small>{e.when}</small>
              </div>
            ))
          }
        </div>

        <div class="rail-sec">
          <h2>Also</h2>
          <p class="also">Private pilot · Competitive hockey · English, French, Spanish</p>
        </div>
      </aside>

      <!-- MAIN RIGHT CANVAS -->
      <main class="main">
        <section class="summary-card">
          <span class="kicker">Executive Summary</span>
          <p class="tagline">Moving software organizations from AI-assisted to AI-first.</p>
          <p class="summary">
            Engineering executive with 17 years leading teams and 19 years shipping production software. Currently
            Director of Software Development at Second Nature, building and rolling out a verification-heavy software
            factory. Previously VP of Software Development at Rev, leading a 60-person organization across AI, SaaS and
            mobile, including the #1 G2-ranked legal AI assistant. Hands-on with LLM systems, multi-agent
            architectures, and agentic software delivery.
          </p>

          <div class="kpis">
            {
              kpis.map((k) => (
                <div class="kpi">
                  <strong>{k.n}</strong>
                  <span>{k.l}</span>
                </div>
              ))
            }
          </div>
        </section>

        <section class="sec">
          <div class="sec-head">
            <span class="kicker">Experience</span>
            <h2>Leadership &amp; Engineering History</h2>
          </div>

          <div class="roles">
            {
              roles.map((r, i) => (
                <article class:list={['role-card', { recent: i < 3 }]}>
                  <div class="role-top">
                    <div>
                      <h3>{r.title}</h3>
                      <p class="co">{r.company} · <span>{r.place}</span></p>
                    </div>
                    <span class="dates">{r.start} – {r.end}</span>
                  </div>
                  <p class="role-sum">{r.summary}</p>
                  {r.points && (
                    <ul class="pts">
                      {r.points.map((pt) => (
                        <li>{pt}</li>
                      ))}
                    </ul>
                  )}
                  {r.stack && <p class="stack">{r.stack}</p>}
                </article>
              ))
            }
          </div>
        </section>

        <section class="sec">
          <div class="sec-head">
            <span class="kicker">Independent R&amp;D</span>
            <h2>Selected Projects</h2>
          </div>
          <div class="proj-grid">
            {
              projects.map((p) => (
                <div class="proj-card">
                  <div class="proj-top">
                    <strong>{p.name}</strong>
                    <span>{p.years}</span>
                  </div>
                  <p>{p.blurb.split('. ')[0]}.</p>
                </div>
              ))
            }
          </div>
        </section>
      </main>
    </div>

    <ResumeSwitcher active="dossier" />
  </body>
</html>

<style>
  :root {
    --bg: #090a0d;
    --bg-2: #11131a;
    --surface-2: #171a24;
    --ink: #f1f5f9;
    --ink-2: #cbd5e1;
    --muted: #94a3b8;
    --rule: rgba(255, 255, 255, 0.1);
    --accent: #38bdf8;
    --accent-2: #818cf8;
    --mono: 'JetBrains Mono', monospace;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    line-height: 1.6;
    padding-bottom: 6rem;
  }
  .ambient {
    position: fixed;
    inset: -15% -10% auto -10%;
    height: 70vh;
    background:
      radial-gradient(55% 50% at 18% 18%, rgba(99, 102, 241, 0.12), transparent 70%),
      radial-gradient(50% 50% at 84% 12%, rgba(56, 189, 248, 0.1), transparent 70%);
    pointer-events: none;
  }
  .wrap {
    max-width: 74rem;
    margin: 0 auto;
    padding-inline: 2rem;
    position: relative;
    z-index: 1;
  }
  .topbar {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(9, 10, 13, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--rule);
  }
  .topbar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 3.8rem;
  }
  .brand {
    color: #fff;
    font-weight: 800;
    text-decoration: none;
    font-size: 1.1rem;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    font-size: 0.9rem;
  }
  .nav a {
    color: var(--muted);
    text-decoration: none;
  }
  .nav a:hover {
    color: var(--accent);
  }
  .print-btn {
    padding: 0.45rem 0.9rem;
    border-radius: 8px;
    border: 1px solid rgba(56, 189, 248, 0.4);
    background: rgba(56, 189, 248, 0.12);
    color: var(--accent);
    font: 600 0.82rem inherit;
    cursor: pointer;
  }
  .print-btn:hover {
    background: var(--accent);
    color: #090a0d;
  }

  .shell {
    display: grid;
    grid-template-columns: 19rem 1fr;
    gap: 2.5rem;
    padding-top: 2.5rem;
    align-items: start;
  }

  /* RAIL */
  .rail {
    position: sticky;
    top: 5.25rem;
    background: var(--bg-2);
    border: 1px solid var(--rule);
    border-radius: 18px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .avatar {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 14px;
    object-fit: cover;
    margin-bottom: 0.85rem;
    border: 1px solid var(--rule);
  }
  .id-card h1 {
    margin: 0;
    font-size: 1.45rem;
    letter-spacing: -0.025em;
  }
  .role {
    margin: 0.15rem 0 0;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.9rem;
  }
  .loc {
    margin: 0.1rem 0 0.85rem;
    color: var(--muted);
    font-size: 0.84rem;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.76rem;
    color: var(--ink-2);
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    background: rgba(52, 211, 153, 0.1);
    border: 1px solid rgba(52, 211, 153, 0.28);
  }
  .dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: #34d399;
  }
  .rail-sec {
    padding-top: 1.15rem;
    border-top: 1px solid var(--rule);
  }
  .rail-sec h2,
  .kicker {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.65rem;
    display: block;
  }
  .contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.84rem;
  }
  .contact-list a {
    color: var(--ink-2);
    text-decoration: none;
  }
  .contact-list a:hover {
    color: var(--accent);
  }
  .edu-item {
    display: flex;
    flex-direction: column;
    margin-bottom: 0.85rem;
  }
  .edu-item:last-child {
    margin-bottom: 0;
  }
  .edu-item strong {
    font-size: 0.9rem;
    color: #fff;
  }
  .edu-item span {
    font-size: 0.82rem;
    color: var(--ink-2);
  }
  .edu-item small {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--muted);
  }
  .also {
    margin: 0;
    font-size: 0.84rem;
    color: var(--muted);
  }

  /* MAIN */
  .summary-card {
    background: var(--bg-2);
    border: 1px solid var(--rule);
    border-radius: 18px;
    padding: 1.75rem;
    margin-bottom: 2.5rem;
  }
  .tagline {
    margin: 0 0 0.65rem;
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .summary {
    margin: 0 0 1.5rem;
    color: var(--muted);
    font-size: 0.96rem;
  }
  .kpis {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.85rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }
  .kpi strong {
    display: block;
    font-size: 1.35rem;
    color: var(--accent);
  }
  .kpi span {
    font-size: 0.78rem;
    color: var(--muted);
  }

  .sec {
    margin-bottom: 2.75rem;
  }
  .sec-head h2 {
    margin: 0 0 1.25rem;
    font-size: 1.5rem;
    letter-spacing: -0.025em;
  }
  .roles {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .role-card {
    background: var(--bg-2);
    border: 1px solid var(--rule);
    border-radius: 14px;
    padding: 1.35rem 1.5rem;
  }
  .role-card.recent {
    border-left: 3px solid var(--accent);
  }
  .role-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }
  .role-top h3 {
    margin: 0;
    font-size: 1.1rem;
    color: #fff;
  }
  .co {
    margin: 0.1rem 0 0;
    font-size: 0.9rem;
    color: var(--ink-2);
    font-weight: 600;
  }
  .co span {
    font-weight: 400;
    color: var(--muted);
  }
  .dates {
    font-family: var(--mono);
    font-size: 0.74rem;
    color: var(--accent);
    white-space: nowrap;
  }
  .role-sum {
    margin: 0.4rem 0 0;
    font-size: 0.92rem;
    color: var(--muted);
  }
  .pts {
    margin: 0.75rem 0 0;
    padding-left: 1.15rem;
    color: var(--ink-2);
    font-size: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .stack {
    margin: 0.75rem 0 0;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--accent-2);
  }

  .proj-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .proj-card {
    background: var(--bg-2);
    border: 1px solid var(--rule);
    border-radius: 14px;
    padding: 1.25rem;
  }
  .proj-top {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.4rem;
  }
  .proj-top span {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--accent);
  }
  .proj-card p {
    margin: 0;
    font-size: 0.86rem;
    color: var(--muted);
  }

  @media (max-width: 960px) {
    .shell,
    .kpis,
    .proj-grid {
      grid-template-columns: 1fr;
    }
    .rail {
      position: static;
    }
    .role-top {
      flex-direction: column;
      gap: 0.2rem;
    }
  }

  @media print {
    body {
      background: #fff;
      color: #111;
      padding: 0;
    }
    .ambient,
    .topbar {
      display: none;
    }
    .shell {
      grid-template-columns: 14rem 1fr;
      gap: 1.5rem;
      padding: 0;
    }
    .rail,
    .summary-card,
    .role-card,
    .proj-card {
      background: #fff;
      border-color: #ddd;
      color: #111;
      break-inside: avoid;
    }
    .role-top h3,
    .edu-item strong,
    .tagline,
    .kpi strong {
      color: #111;
    }
    .summary,
    .role-sum,
    .pts,
    .co,
    .also {
      color: #333;
    }
  }
</style>
