---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ExhibitRow from '../components/ExhibitRow.astro';
import Flourish from '../components/Flourish.astro';
import { person, education } from '../data/site';

const all = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const exhibits = all.filter((e) => e.data.kind === 'exhibit' && e.data.placement === 'main');
const coda = all.filter((e) => e.data.kind === 'exhibit' && e.data.placement === 'coda');
const work = all.filter((e) => e.data.kind === 'work');

// How implementation has shifted from me to AI. `ai` only sets the bar's fill and is illustrative, not measured.
const shift = [
  { year: '2024', what: 'ZorkAI', how: 'I wrote every line. AI was only the narrator.', ai: 0 },
  { year: '2025', what: 'ZorkAI, Planetfall', how: 'AI agents write code against my tests. I review.', ai: 0.55 },
  {
    year: '2026',
    what: 'AdventureBreaker',
    how: 'An AI playtester built to break my AI narrator. AI wrote most of it; I designed it.',
    ai: 0.75,
  },
  { year: '2026', what: 'Unopened Worlds, this site', how: 'AI writes the implementation. I own every decision.', ai: 0.9 },
];

const career = ['Rev', 'Cart.com', 'Sesami', 'Premier Designs', 'LinkGreen', 'Kobo', 'Toolbox', 'Logitech'];
---

<Base title="Michael Lane · VP of Engineering">
  <div class="status-line" aria-hidden="true">
    <span class="sl-loc">Entrance</span>
    <span class="sl-score">Score: 305 merged PRs · Moves: 1991–2026</span>
  </div>

  <section class="hero wrap" data-room="Entrance">
    <h1 aria-label="I lead engineering organizations. I also breathe new life into old worlds.">
      {'I lead engineering organizations. I also'.split(' ').map((w, i) => <><span class="w" aria-hidden="true" style={`--i:${i}`}>{w}</span>{' '}</>)}
      <span class="hl" aria-hidden="true">{'breathe new life into old worlds.'.split(' ').map((w, i, a) => <><span class="w" style={`--i:${i + 6}`}>{w}</span>{i < a.length - 1 && ' '}</>)}</span>
    </h1>
    <p class="lede">
      VP of Engineering, most recently at Rev, where I led 60 people across AI, SaaS and mobile. I’ve been writing
      software since middle school, and every year I hand more of the implementation to AI. What I don’t hand over is the
      judgment.
    </p>

    <div class="split">
      <div class="drive">
        <p class="label">I contribute</p>
        <p>The architecture, the systems design, the patterns, the copy and the design.</p>
      </div>
      <div class="defer">
        <p class="label">AI implements</p>
        <p>The code. More of it every year, reviewed and tested against decisions I’ve made.</p>
      </div>
    </div>

    <ol class="shift" aria-label="How the way I build has changed">
      {
        shift.map((s) => (
          <li style={`--ai: ${s.ai}`}>
            <span class="yr">{s.year}</span>
            <span class="what">{s.what}</span>
            <span class="how">{s.how}</span>
            <span class="bar" aria-hidden="true">
              <i />
            </span>
          </li>
        ))
      }
    </ol>
    <p class="shift-key label"><span class="k me"></span>Written by me <span class="k ai"></span>Written by AI</p>
    <Flourish />
  </section>

  <section id="work" class="work wrap" data-room="The Day Job">
    <div class="work-head">
      <p class="label">The day job</p>
      <h2 class="sec-title">Work I’ve led</h2>
      <p class="intro">What I build with a team. Below it, what I build on my own time.</p>
    </div>
    <div class="cards-wrap">
      <button type="button" class="cards-btn prev" aria-label="Previous">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
      </button>
      <button type="button" class="cards-btn next" aria-label="Next">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
      </button>
      <div class="cards" tabindex="0" aria-label="Work I’ve led">
      {
        work.map((w) => (
          <a class="card" href={`/work/${w.id}`}>
            {w.data.stats[0] && (
              <p class="big">
                {w.data.stats[0].n}
                <span>{w.data.stats[0].label}</span>
              </p>
            )}
            <h3>{w.data.title}</h3>
            <p>{w.data.kicker}</p>
            <span class="more">Case study →</span>
          </a>
        ))
      }
      </div>
    </div>
    <p class="career">
      <span class="label">Career</span>
      {
        career.map((c, i) => (
          <>
            {i > 0 && <span class="sep">·</span>}
            <span>{c}</span>
          </>
        ))
      }
      <a href="/resume">Full résumé →</a>
    </p>
  </section>

  <section id="education" class="edu wrap" data-room="The Library">
    <p class="label">Education</p>
    <h2 class="sec-title">Education</h2>
    <div class="edu-grid">
      {
        education.map((e) => (
          <div class="edu-item">
            <p class="when">{e.when}</p>
            <h3>{e.degree}</h3>
            <p class="school">{e.school}</p>
            <p class="note">
              {'note' in e && e.note}
              {e.link && (
                <>
                  {' '}
                  <a href={e.link.href}>{e.link.label} →</a>
                </>
              )}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {
        [0, 1].map(() => (
          <span>
            {[...exhibits, ...coda].map((e) => (
              <>
                {e.data.title}
                <i>✦</i>
              </>
            ))}
          </span>
        ))
      }
    </div>
  </div>

  <div class="room-sep wrap" data-room="The Exhibit Hall" aria-hidden="true"></div>

  <section id="exhibits" class="exhibits">
    <div class="wrap ex-head"><h2 class="sec-title">Research and Renaissance</h2></div>
    {
      exhibits.map((e, i) => (
        <ExhibitRow
          entry={e}
          label={`${String(i + 1).padStart(2, '0')} · ${e.data.years}`}
          flip={i % 2 === 1}
          eager={i === 0}
        />
      ))
    }
  </section>


  <div class="room-sep wrap" data-room="Where It Started" aria-hidden="true">
    <p class="rs-room">Where It Started</p>
  </div>

  <section class="coda" data-room="1992">
    <p class="label wrap coda-label">Where it started</p>
    {coda.map((e) => <ExhibitRow entry={e} label={e.data.years} />)}
  </section>

  <section id="contact" class="contact wrap" data-room="West of House">
    <p class="label">Contact</p>
    <div class="email">
      <p class="email-label">Email</p>
      <div class="email-row">
        <a class="email-addr" href={`mailto:${person.email}`}>{person.email}</a>
        <button type="button" class="email-copy" data-email={person.email}>Copy</button>
      </div>
    </div>
    <p class="ex-links">
      <a href={person.linkedin}>LinkedIn</a>
      <a href={person.github}>GitHub</a>
      <a href="/resume">Résumé</a>
    </p>
  </section>
</Base>

<script>
  // Work carousel: rolls over endlessly. The cards are cloned once after themselves; when the
  // track scrolls into the clones it jumps back by one set, invisibly. Chevrons page one card at a
  // time, and it advances on its own every 10 seconds, pausing on hover or focus (never for
  // reduced motion).
  const track = document.querySelector<HTMLElement>('.cards');
  const wrap = document.querySelector<HTMLElement>('.cards-wrap');
  const prev = document.querySelector<HTMLButtonElement>('.cards-btn.prev');
  const next = document.querySelector<HTMLButtonElement>('.cards-btn.next');
  if (track && wrap && prev && next) {
    const originals = [...track.children] as HTMLElement[];
    for (const card of originals) {
      const copy = card.cloneNode(true) as HTMLElement;
      copy.setAttribute('aria-hidden', 'true');
      copy.tabIndex = -1;
      copy.classList.add('clone');
      track.append(copy);
    }
    const gap = () => parseFloat(getComputedStyle(track).columnGap) || 20;
    const step = () => originals[0].offsetWidth + gap();
    const setWidth = () => step() * originals.length;
    const jump = (left: number) => track.scrollTo({ left, behavior: 'instant' as ScrollBehavior });
    let settle = 0;
    track.addEventListener(
      'scroll',
      () => {
        clearTimeout(settle);
        settle = window.setTimeout(() => {
          if (track.scrollLeft >= setWidth() - 2) jump(track.scrollLeft - setWidth());
        }, 120);
      },
      { passive: true },
    );
    const go = (dir: 1 | -1) => {
      if (dir === -1 && track.scrollLeft < 4) jump(setWidth());
      track.scrollBy({ left: dir * step(), behavior: 'smooth' });
    };
    let paused = false;
    let timer = 0;
    const restart = () => {
      clearInterval(timer);
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) timer = window.setInterval(() => !paused && go(1), 10000);
    };
    prev.addEventListener('click', () => (go(-1), restart()));
    next.addEventListener('click', () => (go(1), restart()));
    wrap.addEventListener('mouseenter', () => (paused = true));
    wrap.addEventListener('mouseleave', () => (paused = false));
    wrap.addEventListener('focusin', () => (paused = true));
    wrap.addEventListener('focusout', () => (paused = false));
    restart();
  }
</script>

<script>
  document.querySelectorAll<HTMLButtonElement>('.email-copy').forEach((btn) => {
    let timer: number | undefined;
    btn.addEventListener('click', () => {
      const email = btn.dataset.email ?? '';
      navigator.clipboard
        ?.writeText(email)
        .then(() => {
          btn.textContent = 'Copied';
          btn.classList.add('copied');
          window.clearTimeout(timer);
          timer = window.setTimeout(() => {
            btn.textContent = 'Copy';
            btn.classList.remove('copied');
          }, 1600);
        })
        .catch(() => {});
    });
  });
</script>

<style>
  .hero {
    position: relative;
    padding-block: 4.5rem 5rem;
  }
  .hero > :not(.flourish) {
    position: relative;
    z-index: 1;
  }
  .hero h1 {
    font-size: clamp(2.6rem, 6.4vw, 5.2rem);
    max-width: 14ch;
    letter-spacing: -0.025em;
    line-height: 1.14;
  }
  .lede {
    font-size: 1.3rem;
    color: var(--ink-2);
    max-width: 38rem;
    margin-top: 1.75rem;
  }

  .exhibits {
    --ex-gap: 8rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--ex-gap);
  }
  .ex-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    align-items: center;
    font-family: var(--mono);
    font-size: 0.82rem;
    margin-top: 1.5rem;
  }
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 1px;
    margin-top: 3rem;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: 8px;
    overflow: hidden;
    max-width: 52rem;
  }
  .split > div {
    background: var(--bg);
    padding: 1.4rem 1.6rem;
  }
  .drive .label {
    color: var(--accent);
  }
  .split p:not(.label) {
    margin: 0.6rem 0 0;
    color: var(--ink-2);
    font-size: 1.02rem;
  }
  .shift {
    list-style: none;
    padding: 0;
    margin: 3.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .shift li {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .shift .yr {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--accent);
  }
  .shift .what {
    font-size: 1.05rem;
    line-height: 1.3;
  }
  .shift .how {
    font-size: 0.92rem;
    color: var(--ink-2);
    line-height: 1.4;
    flex: 1;
  }
  .shift .bar {
    display: block;
    height: 6px;
    margin-top: 0.6rem;
    border-radius: 3px;
    background: var(--ink-2);
    overflow: hidden;
    direction: rtl;
  }
  .shift .bar i {
    display: block;
    height: 100%;
    width: calc(var(--ai) * 100%);
    background: var(--accent);
  }
  .shift-key {
    margin-top: 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .k {
    display: inline-block;
    width: 0.8rem;
    height: 6px;
    border-radius: 3px;
  }
  .k.me {
    background: var(--ink-2);
  }
  .k.ai {
    background: var(--accent);
    margin-left: 0.8rem;
  }
  .work {
    margin-bottom: 5rem;
  }
  .edu {
    margin-bottom: 8rem;
  }
  .edu-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: 1.25rem;
  }
  .edu-item {
    border-top: 2px solid var(--accent);
    padding-top: 1.25rem;
  }
  .edu-item .when {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }
  .edu-item h3 {
    font-size: 1.7rem;
  }
  .edu-item .school {
    color: var(--ink-2);
    margin: 0.3rem 0 0.75rem;
  }
  .edu-item .note {
    color: var(--muted);
    font-size: 0.98rem;
  }
  .sec-title {
    font-size: clamp(2rem, 3.6vw, 3rem);
    margin-top: 0.75rem;
  }
  .edu .sec-title {
    margin-bottom: 2.5rem;
  }
  /* A grid item with auto side margins shrinks to fit; this one spans the column like the rows below. */
  .ex-head {
    width: 100%;
    /* The exhibit rows are spaced far apart; the heading sits closer to the first one. */
    margin-bottom: calc(3rem - var(--ex-gap, 8rem));
  }
  /* The same blue rule that sits under Education's heading. */
  .exhibits .sec-title {
    margin: 0;
    max-width: none;
    text-align: left;
    padding-bottom: 1.5rem;
    border-bottom: 2px solid var(--accent);
  }
  .intro {
    color: var(--ink-2);
    margin-top: 0.75rem;
  }
  /* A carousel, two cards at a time: a scroll-snapping track with arrows. */
  /* The track is inset so the chevrons live in their own gutters, never over the cards. */
  .cards-wrap {
    position: relative;
    margin-top: 2.5rem;
    padding-inline: 3.75rem;
  }
  /* Chevrons sit on either side of the track, vertically centered. */
  .cards-btn {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--bg-2);
    color: var(--ink);
    box-shadow: 0 4px 16px -6px rgba(0, 0, 0, 0.25);
    transform: translateY(-50%);
    cursor: pointer;
    transition:
      background-color 0.15s,
      color 0.15s;
  }
  .cards-btn.prev {
    left: 0;
  }
  .cards-btn.next {
    right: 0;
  }
  .cards-btn svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .cards-btn:hover {
    background: var(--accent);
    color: var(--on-accent);
  }
  .cards {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 1.25rem) / 2);
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .cards::-webkit-scrollbar {
    display: none;
  }
  .cards > .card {
    scroll-snap-align: start;
  }
  .card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: var(--bg-2);
    border: 1px solid var(--rule);
    border-radius: 8px;
    padding: 1.75rem;
    transition:
      border-color 0.15s,
      transform 0.15s;
  }
  .card:hover {
    color: inherit;
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .card .big {
    font-size: 3.4rem;
    line-height: 1;
    color: var(--accent);
    margin-bottom: 1.5rem;
  }
  .card .big span {
    display: block;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--muted);
    margin-top: 0.6rem;
    line-height: 1.4;
  }
  .card h3 {
    font-size: 1.45rem;
    margin-bottom: 0.4rem;
  }
  .card p {
    color: var(--ink-2);
    font-size: 1rem;
  }
  .more {
    margin-top: auto;
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--accent);
  }
  .career {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.7rem;
    align-items: baseline;
    margin-top: 3rem;
    color: var(--ink-2);
    font-size: 1.05rem;
  }
  .career .label {
    margin-right: 0.75rem;
  }
  .career .sep {
    color: var(--muted);
  }
  .career a {
    font-family: var(--mono);
    font-size: 0.82rem;
    margin-left: 0.75rem;
  }

  .coda {
    margin-top: 9rem;
    padding-top: 5rem;
    border-top: 1px solid var(--rule);
  }
  .coda-label {
    margin-bottom: 2.5rem;
  }
  .contact {
    margin-top: 6rem;
  }
  .email {
    margin: 0.75rem 0 2rem;
  }
  .email-label {
    margin: 0 0 0.6rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .email-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }
  /* The mockup theme underlines every .contact link; the address gets its own sweep instead. */
  :global(:root:root:root:root) .contact .email-addr {
    min-width: 0;
    overflow-wrap: anywhere;
    font-family: var(--body);
    font-size: clamp(1.6rem, 3vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--ink);
    text-decoration: none;
    padding-bottom: 0.08em;
    background: linear-gradient(var(--accent), var(--accent)) left bottom / 0% 2px no-repeat;
    transition: background-size 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  :global(:root:root:root:root) .contact .email-addr:hover,
  :global(:root:root:root:root) .contact .email-addr:focus-visible {
    background-image: linear-gradient(var(--accent), var(--accent));
    background-size: 100% 2px;
  }
  .email-copy {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-2);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.4rem 0.8rem;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }
  .email-copy:hover,
  .email-copy:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
  }
  .email-copy.copied {
    color: var(--accent);
    border-color: var(--accent);
  }

  @media (max-width: 960px) {
    .exhibits {
      --ex-gap: 5rem;
    }
    .cards {
      grid-auto-columns: 100%;
    }
    .cards-wrap {
      padding-inline: 2.5rem;
    }
    .cards-btn {
      width: 2.1rem;
      height: 2.1rem;
    }
    .edu-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .shift {
      grid-template-columns: 1fr 1fr;
      gap: 1.75rem 1.25rem;
    }
  }
  @media (max-width: 760px) {
    .split {
      grid-template-columns: 1fr;
    }
    .hero {
      padding-block: 2rem 3.5rem;
    }
    .lede {
      font-size: 1.12rem;
    }
  }
</style>
