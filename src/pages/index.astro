---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ExhibitRow from '../components/ExhibitRow.astro';
import { person, education } from '../data/site';

const all = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const exhibits = all.filter((e) => e.data.kind === 'exhibit' && e.data.placement === 'main');
const coda = all.filter((e) => e.data.kind === 'exhibit' && e.data.placement === 'coda');
const work = all.filter((e) => e.data.kind === 'work');

// How implementation has shifted from me to AI. `ai` only sets the bar's fill and is illustrative, not measured.
const shift = [
  { year: '2024', what: 'ZorkAI', how: 'I wrote the engine. AI was the narrator.', ai: 0.15 },
  { year: '2025', what: 'ZorkAI, Planetfall', how: 'AI agents write code against my tests. I review.', ai: 0.55 },
  {
    year: '2026',
    what: 'AdventureBreaker',
    how: 'An AI playtester built to break my AI narrator. AI wrote most of it; I designed it.',
    ai: 0.75,
  },
  { year: '2026', what: 'Unopened Worlds, this site', how: 'AI writes the implementation. I own every decision.', ai: 0.9 },
];

const career = ['Rev', 'Cart.com', 'Sesami', 'Premier Designs', 'LinkGreen', 'Kobo', 'Toolbox', 'Logitech'];
---

<Base title="Michael Lane · VP of Engineering">
  <section class="hero wrap">
    <h1>I lead engineering organizations. I also breathe new life into old worlds.</h1>
    <p class="lede">
      VP of Engineering, most recently at Rev, where I led 60 people across AI, SaaS and mobile. I’ve been writing
      software since 1991, and every year I hand more of the implementation to AI. What I don’t hand over is the
      thinking.
    </p>

    <div class="split">
      <div class="drive">
        <p class="label">I drive</p>
        <p>The architecture, the systems design, the patterns, the copy and the design.</p>
      </div>
      <div class="defer">
        <p class="label">AI implements</p>
        <p>The code. More of it every year, reviewed and tested against decisions I’ve made.</p>
      </div>
    </div>

    <ol class="shift" aria-label="How the way I build has changed">
      {
        shift.map((s) => (
          <li style={`--ai: ${s.ai}`}>
            <span class="yr">{s.year}</span>
            <span class="what">{s.what}</span>
            <span class="how">{s.how}</span>
            <span class="bar" aria-hidden="true">
              <i />
            </span>
          </li>
        ))
      }
    </ol>
    <p class="shift-key label"><span class="k me"></span>Written by me <span class="k ai"></span>Written by AI</p>
  </section>

  <section id="work" class="work wrap">
    <div class="work-head">
      <p class="label">The day job</p>
      <h2>Work I’ve led</h2>
      <p class="intro">What I build with a team. Below it, what I build on my own time.</p>
    </div>
    <div class="cards">
      {
        work.map((w) => (
          <a class="card" href={`/work/${w.id}`}>
            {w.data.stats[0] && (
              <p class="big">
                {w.data.stats[0].n}
                <span>{w.data.stats[0].label}</span>
              </p>
            )}
            <h3>{w.data.title}</h3>
            <p>{w.data.kicker}</p>
            <span class="more">Case study →</span>
          </a>
        ))
      }
    </div>
    <p class="career">
      <span class="label">Career</span>
      {
        career.map((c, i) => (
          <>
            {i > 0 && <span class="sep">·</span>}
            <span>{c}</span>
          </>
        ))
      }
      <a href="/resume">Full résumé →</a>
    </p>
  </section>

  <section id="education" class="edu wrap">
    <p class="label">Education</p>
    <div class="edu-grid">
      {
        education.map((e) => (
          <div class="edu-item">
            <p class="when">{e.when}</p>
            <h3>{e.degree}</h3>
            <p class="school">{e.school}</p>
            <p class="note">
              {'note' in e && e.note}
              {e.link && (
                <>
                  {' '}
                  <a href={e.link.href}>{e.link.label} →</a>
                </>
              )}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <section id="exhibits" class="exhibits">
    {
      exhibits.map((e, i) => (
        <ExhibitRow
          entry={e}
          label={`${String(i + 1).padStart(2, '0')} · ${e.data.years}`}
          flip={i % 2 === 1}
          eager={i === 0}
        />
      ))
    }
  </section>


  <section class="coda">
    <p class="label wrap coda-label">Where it started</p>
    {coda.map((e) => <ExhibitRow entry={e} label={e.data.years} />)}
  </section>

  <section id="contact" class="contact wrap">
    <p class="label">Contact</p>
    <p class="lede">
      <a href={`mailto:${person.email}`}>{person.email}</a>
    </p>
    <p class="ex-links">
      <a href={person.linkedin}>LinkedIn</a>
      <a href={person.github}>GitHub</a>
      <a href="/resume">Résumé</a>
    </p>
  </section>
</Base>

<style>
  .hero {
    padding-block: 4.5rem 5rem;
  }
  .hero h1 {
    font-size: clamp(2.6rem, 6.4vw, 5.2rem);
    max-width: 14ch;
    letter-spacing: -0.025em;
    line-height: 1.14;
  }
  .lede {
    font-size: 1.3rem;
    color: var(--ink-2);
    max-width: 38rem;
    margin-top: 1.75rem;
  }

  .exhibits {
    display: grid;
    gap: 8rem;
  }
  .ex-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    align-items: center;
    font-family: var(--mono);
    font-size: 0.82rem;
    margin-top: 1.5rem;
  }
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 1px;
    margin-top: 3rem;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: 8px;
    overflow: hidden;
    max-width: 52rem;
  }
  .split > div {
    background: var(--bg);
    padding: 1.4rem 1.6rem;
  }
  .drive .label {
    color: var(--accent);
  }
  .split p:not(.label) {
    margin: 0.6rem 0 0;
    color: var(--ink-2);
    font-size: 1.02rem;
  }
  .shift {
    list-style: none;
    padding: 0;
    margin: 3.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .shift li {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .shift .yr {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--accent);
  }
  .shift .what {
    font-size: 1.05rem;
    line-height: 1.3;
  }
  .shift .how {
    font-size: 0.92rem;
    color: var(--ink-2);
    line-height: 1.4;
    flex: 1;
  }
  .shift .bar {
    display: block;
    height: 6px;
    margin-top: 0.6rem;
    border-radius: 3px;
    background: var(--ink-2);
    overflow: hidden;
    direction: rtl;
  }
  .shift .bar i {
    display: block;
    height: 100%;
    width: calc(var(--ai) * 100%);
    background: var(--accent);
  }
  .shift-key {
    margin-top: 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .k {
    display: inline-block;
    width: 0.8rem;
    height: 6px;
    border-radius: 3px;
  }
  .k.me {
    background: var(--ink-2);
  }
  .k.ai {
    background: var(--accent);
    margin-left: 0.8rem;
  }
  .work {
    margin-bottom: 5rem;
  }
  .edu {
    margin-bottom: 8rem;
  }
  .edu-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: 1.25rem;
  }
  .edu-item {
    border-top: 2px solid var(--accent);
    padding-top: 1.25rem;
  }
  .edu-item .when {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }
  .edu-item h3 {
    font-size: 1.7rem;
  }
  .edu-item .school {
    color: var(--ink-2);
    margin: 0.3rem 0 0.75rem;
  }
  .edu-item .note {
    color: var(--muted);
    font-size: 0.98rem;
  }
  .work-head h2 {
    font-size: clamp(2rem, 3.6vw, 3rem);
    margin-top: 0.75rem;
  }
  .intro {
    color: var(--ink-2);
    margin-top: 0.75rem;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: 2.5rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: var(--bg-2);
    border: 1px solid var(--rule);
    border-radius: 8px;
    padding: 1.75rem;
    transition:
      border-color 0.15s,
      transform 0.15s;
  }
  .card:hover {
    color: inherit;
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .card .big {
    font-size: 3.4rem;
    line-height: 1;
    color: var(--accent);
    margin-bottom: 1.5rem;
  }
  .card .big span {
    display: block;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--muted);
    margin-top: 0.6rem;
    line-height: 1.4;
  }
  .card h3 {
    font-size: 1.45rem;
    margin-bottom: 0.4rem;
  }
  .card p {
    color: var(--ink-2);
    font-size: 1rem;
  }
  .more {
    margin-top: auto;
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--accent);
  }
  .career {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.7rem;
    align-items: baseline;
    margin-top: 3rem;
    color: var(--ink-2);
    font-size: 1.05rem;
  }
  .career .label {
    margin-right: 0.75rem;
  }
  .career .sep {
    color: var(--muted);
  }
  .career a {
    font-family: var(--mono);
    font-size: 0.82rem;
    margin-left: 0.75rem;
  }

  .coda {
    margin-top: 9rem;
    padding-top: 5rem;
    border-top: 1px solid var(--rule);
  }
  .coda-label {
    margin-bottom: 2.5rem;
  }
  .contact {
    margin-top: 6rem;
  }
  .contact .lede {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin-top: 0.75rem;
  }

  @media (max-width: 960px) {
    .exhibits {
      gap: 5rem;
    }
    .cards {
      grid-template-columns: 1fr;
    }
    .edu-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .shift {
      grid-template-columns: 1fr 1fr;
      gap: 1.75rem 1.25rem;
    }
  }
  @media (max-width: 760px) {
    .split {
      grid-template-columns: 1fr;
    }
    .hero {
      padding-block: 2rem 3.5rem;
    }
    .lede {
      font-size: 1.12rem;
    }
  }
</style>
