---
interface Props {
  active: 'hub' | 'dossier' | 'timeline' | 'ledger';
}

const { active } = Astro.props;

const items = [
  { id: 'hub', label: 'All Résumé Options', href: '/mockups/resume' },
  { id: 'dossier', label: '01 · Dossier', href: '/mockups/resume-dossier' },
  { id: 'timeline', label: '02 · Timeline', href: '/mockups/resume-timeline' },
  { id: 'ledger', label: '03 · Ledger', href: '/mockups/resume-ledger' },
  { id: 'current', label: 'Current /resume ↗', href: '/resume' },
] as const;
---

<nav class="rm-bar" aria-label="Résumé design mockups">
  <span class="rm-badge">Résumé Mockups</span>
  <div class="rm-links">
    {
      items.map((item) => (
        <a
          href={item.href}
          class:list={['rm-link', { active: item.id === active }]}
          aria-current={item.id === active ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </div>
</nav>

<style>
  .rm-bar {
    position: fixed;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 9999;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.45rem 0.6rem 0.45rem 0.9rem;
    border-radius: 999px;
    background: rgba(15, 17, 23, 0.9);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.35);
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 0.8125rem;
    max-width: calc(100vw - 1.5rem);
    overflow-x: auto;
  }
  .rm-badge {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #38bdf8;
    white-space: nowrap;
    padding-right: 0.45rem;
    border-right: 1px solid rgba(255, 255, 255, 0.12);
  }
  .rm-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .rm-link {
    color: #cbd5e1;
    text-decoration: none;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    font-weight: 500;
    white-space: nowrap;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .rm-link:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.1);
  }
  .rm-link.active {
    background: #38bdf8;
    color: #090a0d;
    font-weight: 600;
  }
  @media print {
    .rm-bar {
      display: none;
    }
  }
  @media (max-width: 640px) {
    .rm-badge {
      display: none;
    }
  }
</style>
