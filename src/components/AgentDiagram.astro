---
// PlayZork, one turn played out: Zork describes the room, narrow agents each propose a command with an expected value
// (importance × confidence), an action already refuted is zeroed, the arbiter weighs them and picks exactly one, and
// the game answers. At rest (no script, or reduced motion) it shows the finished turn.
const proposals = [
  { who: 'Issue #12', cmd: 'UNLOCK GRATING WITH KEY', why: 'we carry the skeleton key', ev: 68 },
  { who: 'Issue #7', cmd: 'TURN ON LAMP', why: 'the lamp is unlit', ev: 42 },
  { who: 'Explorer', cmd: 'GO NORTH', why: 'an exit not yet on the map', ev: 37.5 },
  { who: 'Issue #3', cmd: 'ATTACK TROLL WITH SWORD', why: 'the odds are poor', ev: 18 },
  // Proposed at 31.5, then zeroed because it already failed.
  { who: 'Issue #9', cmd: 'READ LEAFLET', why: 'already failed on turn 31', ev: 31.5, refuted: true },
];
const fmt = (n: number) => n.toFixed(1);
const rowY = (i: number) => 164 + i * 50;
// IBM Plex Mono at 14px is about 8.4px a character, for the strike-through.
const strikeW = (s: string) => s.length * 8.4;
---

<svg
  class="turn"
  viewBox="0 0 800 500"
  role="img"
  aria-label="Turn 47, in the Clearing, where a grating is fastened into the ground. Five agents each propose a command: UNLOCK GRATING WITH KEY (expected value 68), TURN ON LAMP (42), GO NORTH (37.5), ATTACK TROLL WITH SWORD (18), and READ LEAFLET, zeroed because it already failed. The arbiter chooses UNLOCK GRATING WITH KEY, and Zork answers: the grating is unlocked."
>
  <text x="48" y="58" class="tag">TURN 47 · CLEARING</text>
  <text x="752" y="58" class="tag phase"></text>
  <text x="48" y="96" class="zork">There is a grating securely fastened into the ground.</text>

  <text x="48" y="148" class="tag">FIVE AGENTS PROPOSE</text>
  <text x="752" y="148" class="tag end">VALUE</text>

  <!-- The arbiter's attention, moving down the rows while it weighs them. -->
  <rect x="40" y={rowY(0) + 1} width="720" height="48" rx="6" class="scan"></rect>

  {
    proposals.map((p, i) => {
      const y = rowY(i);
      return (
        <g class:list={['row', { win: i === 0, refuted: p.refuted }]} data-ev={p.ev}>
          <line x1="48" x2="752" y1={y} y2={y} class="rule" />
          <text x="72" y={y + 22} class="cmd">{p.cmd}</text>
          {p.refuted && <line x1="70" x2={74 + strikeW(p.cmd)} y1={y + 17} y2={y + 17} class="strike" />}
          <text x="72" y={y + 39} class="why">{p.who} · {p.why}</text>
          <rect x="560" y={y + 23} width="140" height="3" rx="1.5" class="track" />
          <rect x="560" y={y + 23} width={1.4 * p.ev} height="3" rx="1.5" class="fill" />
          <text x="752" y={y + 28} class="ev">{fmt(p.refuted ? 0 : p.ev)}</text>
        </g>
      );
    })
  }
  <line x1="48" x2="752" y1={rowY(5)} y2={rowY(5)} class="rule" />

  <!-- The decision flows from the winning row down to the command sent to Zork. -->
  <path d={`M56 ${rowY(0) + 31} V466`} class="flow" pathLength="1"></path>
  <circle cx="56" cy={rowY(0) + 25} r="4" class="dot"></circle>
  <circle cx="56" cy="466" r="4" class="dot end-dot"></circle>

  <text x="72" y="446" class="tag pick-tag">ARBITER CHOOSES</text>
  <text x="72" y="471" class="pick">&gt; UNLOCK GRATING WITH KEY</text>
  <text x="752" y="471" class="reply">The grating is unlocked.</text>
</svg>

<script>
  // Plays the turn on a loop while it's on screen. Every step adds a class or rewrites a little text; CSS does the rest.
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const fmt = (n: number) => n.toFixed(1);

  function countTo(el: Element, from: number, to: number, ms: number) {
    const t0 = performance.now();
    return new Promise<void>((done) => {
      const tick = (t: number) => {
        const k = Math.min(1, (t - t0) / ms);
        el.textContent = fmt(from + (to - from) * (1 - Math.pow(1 - k, 3)));
        if (k < 1) requestAnimationFrame(tick);
        else done();
      };
      requestAnimationFrame(tick);
    });
  }

  async function type(el: Element, text: string, perChar: number) {
    for (let i = 1; i <= text.length; i++) {
      el.textContent = text.slice(0, i);
      await sleep(perChar);
    }
  }

  function play(svg: SVGSVGElement) {
    const $ = (s: string) => svg.querySelector(s)!;
    const rows = [...svg.querySelectorAll<SVGGElement>('.row')];
    const phase = $('.phase');
    const zork = $('.zork');
    const pick = $('.pick');
    const scan = $('.scan') as SVGRectElement;
    const zorkText = zork.textContent ?? '';
    const pickText = pick.textContent ?? '';
    let visible = false;
    let running = false;

    const say = async (text: string) => {
      phase.classList.remove('on');
      await sleep(150);
      phase.textContent = text;
      phase.classList.add('on');
    };
    const scanTo = (i: number) => (scan.style.transform = `translateY(${i * 50}px)`);

    async function turn() {
      // Reset to an empty turn.
      svg.classList.remove('fade');
      svg.querySelectorAll('.on, .lit, .zeroed').forEach((el) => el.classList.remove('on', 'lit', 'zeroed'));
      zork.textContent = '';
      pick.textContent = '';
      rows.forEach((r) => (r.querySelector('.ev')!.textContent = fmt(0)));
      scanTo(0);
      await sleep(400);

      await say('Zork describes the room');
      zork.classList.add('on');
      await type(zork, zorkText, 22);
      await sleep(500);

      await say('Five agents propose');
      for (const r of rows) {
        r.classList.add('on');
        countTo(r.querySelector('.ev')!, 0, Number(r.dataset.ev), 700);
        await sleep(420);
      }
      await sleep(700);

      await say('Refuted actions are zeroed');
      for (const r of rows.filter((r) => r.classList.contains('refuted'))) {
        r.classList.add('zeroed');
        countTo(r.querySelector('.ev')!, Number(r.dataset.ev), 0, 600);
      }
      await sleep(1100);

      await say('The arbiter weighs them');
      scan.classList.add('on');
      for (const i of [0, 1, 2, 3, 0]) {
        scanTo(i);
        await sleep(380);
      }
      rows[0].classList.add('lit');
      $('.dot').classList.add('on');
      await sleep(600);

      await say('The arbiter chooses exactly one');
      svg.querySelector('.flow')!.classList.add('on');
      await sleep(500);
      $('.end-dot').classList.add('on');
      $('.pick-tag').classList.add('on');
      pick.classList.add('on');
      await type(pick, pickText, 32);
      await sleep(400);

      await say('Zork answers');
      $('.reply').classList.add('on');
      await sleep(4200);

      svg.classList.add('fade');
      await sleep(700);
    }

    async function loop() {
      if (running) return;
      running = true;
      svg.classList.add('live');
      while (visible) await turn();
      running = false;
    }

    new IntersectionObserver(
      ([e]) => {
        visible = e.isIntersecting;
        if (visible) loop();
      },
      { threshold: 0.4 },
    ).observe(svg);
  }

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<SVGSVGElement>('svg.turn').forEach(play);
  }
</script>

<style>
  .turn {
    width: 100%;
    height: 100%;
    display: block;
    background: var(--bg-2);
    font-family: var(--mono);
  }
  .tag {
    fill: var(--muted);
    font-size: 11px;
    letter-spacing: 0.12em;
  }
  .end,
  .ev,
  .reply,
  .phase {
    text-anchor: end;
  }
  .phase {
    fill: var(--accent);
    letter-spacing: 0.04em;
  }
  .zork {
    font-family: var(--body);
    font-size: 23px;
    font-weight: 600;
    letter-spacing: -0.01em;
    fill: var(--ink);
  }
  .rule {
    stroke: var(--rule);
  }
  .cmd {
    fill: var(--ink);
    font-size: 14px;
    font-weight: 600;
  }
  .why {
    font-family: var(--body);
    fill: var(--muted);
    font-size: 12px;
  }
  .track {
    fill: color-mix(in srgb, var(--ink) 8%, transparent);
  }
  .fill {
    fill: color-mix(in srgb, var(--ink) 35%, transparent);
    transform-box: fill-box;
    transform-origin: left;
  }
  .ev {
    fill: var(--ink-2);
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }
  .scan {
    fill: color-mix(in srgb, var(--accent) 7%, transparent);
    opacity: 0;
  }
  .strike {
    stroke: var(--muted);
    stroke-width: 1.5;
  }
  .flow {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
  }
  .dot {
    fill: var(--accent);
  }
  .pick {
    fill: var(--accent);
    font-size: 15px;
    font-weight: 700;
  }
  .reply {
    font-family: var(--body);
    font-size: 15px;
    fill: var(--ink-2);
  }

  /* The finished turn, as it rests: the winner lit, the refuted proposal struck and zeroed. */
  .win .cmd,
  .win .ev {
    fill: var(--accent);
  }
  .win .fill {
    fill: var(--accent);
  }
  .refuted .cmd,
  .refuted .ev {
    fill: var(--muted);
  }
  .refuted .fill {
    transform: scaleX(0);
  }

  /* Playing: everything starts hidden and each step turns its piece on. */
  .live :is(.zork, .row, .pick-tag, .pick, .reply, .dot, .phase, .flow) {
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .live .row {
    transform: translateY(6px);
    transition:
      opacity 0.4s ease,
      transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .live .fill {
    transform: scaleX(0);
    transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .live .on {
    opacity: 1;
  }
  .live .row.on {
    transform: none;
  }
  .live .row.on .fill {
    transform: scaleX(1);
  }
  .live .scan {
    transition:
      transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 0.3s;
  }
  .live .scan.on {
    opacity: 1;
  }
  .live .dot {
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0);
    transition:
      opacity 0.2s,
      transform 0.35s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .live .dot.on {
    transform: scale(1);
  }
  .live .flow {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition:
      opacity 0.2s,
      stroke-dashoffset 0.6s cubic-bezier(0.6, 0, 0.3, 1);
  }
  .live .flow.on {
    stroke-dashoffset: 0;
  }
  /* Until the arbiter picks, the winner looks like everyone else. */
  .live .win:not(.lit) .cmd {
    fill: var(--ink);
  }
  .live .win:not(.lit) .ev {
    fill: var(--ink-2);
  }
  .live .win:not(.lit) .fill {
    fill: color-mix(in srgb, var(--ink) 35%, transparent);
  }
  .live .win :is(.cmd, .ev, .fill) {
    transition:
      fill 0.3s,
      transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  /* Refuted: proposed like the rest, then struck and zeroed. */
  .live .refuted:not(.zeroed) .cmd {
    fill: var(--ink);
  }
  .live .refuted:not(.zeroed) .ev {
    fill: var(--ink-2);
  }
  .live .refuted.on:not(.zeroed) .fill {
    transform: scaleX(1);
  }
  .live .refuted.zeroed .fill {
    transform: scaleX(0);
  }
  .live .strike {
    transform-box: fill-box;
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 0.4s ease;
  }
  .live .zeroed .strike {
    transform: scaleX(1);
  }
  .live .refuted :is(.cmd, .ev) {
    transition: fill 0.3s;
  }
  /* The end of a turn: everything fades before the next begins. */
  .live.fade :is(.zork, .row, .scan, .flow, .dot, .pick-tag, .pick, .reply, .phase) {
    opacity: 0;
    transition: opacity 0.6s ease;
  }
</style>
