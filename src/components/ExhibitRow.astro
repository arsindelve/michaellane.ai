---
import type { CollectionEntry } from 'astro:content';
import Exhibit from './Exhibit.astro';
import AgentDiagram from './AgentDiagram.astro';
import BreakerDiagram from './BreakerDiagram.astro';

interface Props {
  entry: CollectionEntry<'work'>;
  label: string;
  flip?: boolean;
  eager?: boolean;
}

const { entry, label, flip = false, eager = false } = Astro.props;
const d = entry.data;
const primary = d.embed?.url ?? d.links[0]?.url ?? 'https://github.com/arsindelve';
---

<article class:list={['ex wrap', { flip }]} data-room={d.title}>
  <div class="ex-media">
    {
      d.cover ? (
        <Exhibit src={d.cover} alt={d.coverAlt} url={primary} embed={d.embed} anim={d.animation} slides={d.slides} eager={eager} />
      ) : (
        <Exhibit url={primary}>
          {d.diagram === 'breaker' ? <BreakerDiagram /> : <AgentDiagram />}
        </Exhibit>
      )
    }
  </div>
  <div class="ex-text">
    <p class="label">{label}</p>
    <h2>{d.title}</h2>
    <p class="kicker">{d.kicker}</p>
    {d.stack.length > 0 && <p class="medium">{d.stack.join(', ')}</p>}
    <p class="summary">{d.summary}</p>
    {
      d.quote && (
        <blockquote class="quote">
          <p>{d.quote.text}</p>
          <cite>{d.quote.by}</cite>
        </blockquote>
      )
    }
    {
      d.me && d.ai && (
        <dl class="credit">
          <div>
            <dt>Me</dt>
            <dd>{d.me}</dd>
          </div>
          <div>
            <dt>AI</dt>
            <dd>{d.ai}</dd>
          </div>
        </dl>
      )
    }
    <p class="ex-links">
      <a class="cta" href={`/work/${entry.id}`}>Case study →</a>
      {
        d.links.slice(0, 2).map((l) => (
          <a href={l.url}>
            <span class="full">{l.label}</span>
            <span class="short">{l.short ?? l.label}</span>
          </a>
        ))
      }
    </p>
  </div>
</article>

<style>
  .ex {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: 3.5rem;
    align-items: center;
  }
  /* Flipped rows mirror the columns too, so every screenshot gets the wide column. */
  .ex.flip {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.55fr);
  }
  .ex.flip .ex-media {
    order: 2;
  }
  /* Set by Exhibit when a live game is loaded: give it the whole row. */
  .ex:global(.playing) {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  .ex:global(.playing) .ex-media {
    order: 0;
    scroll-margin-top: 1.5rem;
  }
  .ex h2 {
    font-size: clamp(2rem, 3.4vw, 2.8rem);
    margin-top: 0.75rem;
  }
  .kicker {
    font-style: italic;
    color: var(--accent);
    font-size: 1.2rem;
    margin: 0.5rem 0 1rem;
  }
  .medium,
  .short {
    display: none;
  }
  .summary {
    color: var(--ink-2);
    font-size: 1.05rem;
  }
  .quote {
    position: relative;
    margin: 1.75rem 0;
    padding: 1.6rem 1.6rem 1.4rem 4.2rem;
    background: color-mix(in srgb, var(--accent) 7%, var(--bg-2));
    border-left: 3px solid var(--accent);
  }
  .quote::before {
    content: '“';
    position: absolute;
    left: 1.1rem;
    top: 0.6rem;
    font-size: 4.5rem;
    line-height: 1;
    font-weight: 800;
    color: var(--accent);
  }
  .quote p {
    margin: 0 0 0.9rem;
    font-size: 1.25rem;
    line-height: 1.4;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--ink);
  }
  .quote cite {
    display: block;
    font-style: normal;
    font-size: 0.9rem;
    color: var(--ink-2);
  }
  .quote cite::before {
    content: '— ';
  }
  .credit {
    margin: 1.5rem 0;
    display: grid;
    gap: 0.9rem;
    border-left: 2px solid var(--accent);
    padding-left: 1rem;
  }
  .credit dt {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .credit dd {
    margin: 0.15rem 0 0;
    font-size: 0.95rem;
    color: var(--ink-2);
    line-height: 1.5;
  }
  .ex-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    align-items: center;
    font-family: var(--mono);
    font-size: 0.82rem;
    margin-top: 1.5rem;
  }
  .cta {
    color: var(--on-accent);
    background: var(--accent);
    text-decoration: none;
    padding: 0.55rem 1rem;
    border-radius: 3px;
  }
  .cta:hover {
    color: var(--bg);
    background: var(--ink);
  }
  @media (max-width: 960px) {
    .ex,
    .ex.flip {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }
    .ex.flip .ex-media {
      order: 0;
    }
  }
</style>
