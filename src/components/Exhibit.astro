---
// A screenshot in a browser frame. If `embed` is given, clicking "Play here"
// swaps the screenshot for the live site in an iframe (on phones it opens a new tab).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  url: string;
  embed?: { url: string; label: string };
  // A recorded session in public/anim/, played instead of the still screenshot.
  anim?: string;
  // A crossfading slideshow of screenshots; each slide's path updates the address bar.
  slides?: Array<{ src: ImageMetadata; alt: string; path: string }>;
  eager?: boolean;
}

const { src, alt = '', url, embed, anim, slides, eager = false } = Astro.props;
const host = new URL(url).host + new URL(url).pathname.replace(/\/$/, '');
---

<figure class:list={['exhibit', { carousel: slides?.length }]} data-embed={embed?.url} data-host={host}>
  <div class="chrome">
    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="addr" aria-hidden="true">{host}{slides?.[0]?.path}</span>
    {
      slides && (
        <span class="pager" role="tablist" aria-label="Screenshots">
          {slides.map((s, i) => (
            <button type="button" class:list={['pip', { on: i === 0 }]} role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-label={`Screenshot ${i + 1} of ${slides.length}`} data-path={s.path} />
          ))}
        </span>
      )
    }
  </div>
  <div class="stage">
    {
      slides ? (
        slides.map((s, i) => (
          <Image
            src={s.src}
            alt={s.alt}
            class:list={['slide', { on: i === 0 }]}
            widths={[640, 960, 1440, 2000]}
            sizes="(max-width: 760px) 100vw, 1100px"
            loading={eager && i === 0 ? 'eager' : 'lazy'}
          />
        ))
      ) : anim ? (
        <picture>
          <source srcset={`/anim/${anim}-still.webp`} media="(prefers-reduced-motion: reduce)" />
          <img
            src={`/anim/${anim}.webp`}
            alt={alt}
            width="1280"
            height="800"
            loading={eager ? 'eager' : 'lazy'}
            decoding="async"
          />
        </picture>
      ) : src ? (
        <Image
          src={src}
          alt={alt}
          widths={[640, 960, 1440, 2000]}
          sizes="(max-width: 760px) 100vw, 1100px"
          loading={eager ? 'eager' : 'lazy'}
        />
      ) : (
        <slot />
      )
    }
  </div>
</figure>
{
  embed && (
    <button type="button" class="play">
      <span class="tri" aria-hidden="true" />
      {embed.label} here
    </button>
  )
}

<script>
  // Carousels: crossfade on a timer, pause on hover, jump with the pips in the address bar.
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  for (const fig of document.querySelectorAll<HTMLElement>('.exhibit.carousel')) {
    const slides = [...fig.querySelectorAll<HTMLElement>('.slide')];
    const pips = [...fig.querySelectorAll<HTMLButtonElement>('.pip')];
    const addr = fig.querySelector('.addr');
    let at = 0;
    let paused = false;
    const show = (n: number) => {
      at = (n + slides.length) % slides.length;
      slides.forEach((s, i) => s.classList.toggle('on', i === at));
      pips.forEach((p, i) => {
        p.classList.toggle('on', i === at);
        p.setAttribute('aria-selected', String(i === at));
      });
      if (addr) addr.textContent = (fig.dataset.host ?? '') + (pips[at]?.dataset.path ?? '');
    };
    pips.forEach((p, i) => p.addEventListener('click', () => show(i)));
    fig.addEventListener('mouseenter', () => (paused = true));
    fig.addEventListener('mouseleave', () => (paused = false));
    if (!still) setInterval(() => !paused && show(at + 1), 3800);
  }

  for (const fig of document.querySelectorAll<HTMLElement>('.exhibit[data-embed]')) {
    const next = fig.nextElementSibling;
    const button = next?.classList.contains('play') ? (next as HTMLButtonElement) : null;
    button?.addEventListener('click', () => {
      const url = fig.dataset.embed!;
      if (window.matchMedia('(max-width: 760px)').matches) {
        window.open(url, '_blank', 'noopener');
        return;
      }
      const stage = fig.querySelector('.stage')!;
      const frame = document.createElement('iframe');
      frame.src = url;
      frame.title = button.textContent?.trim() ?? 'Live project';
      frame.allow = 'fullscreen; clipboard-write; autoplay';
      stage.replaceChildren(frame);
      button.hidden = true;
      fig.classList.add('live');
      // Give the live game the whole row, not half of it.
      fig.closest('.ex')?.classList.add('playing');
      fig.scrollIntoView({ behavior: 'smooth', block: 'start' });
      frame.focus();
    });
  }
</script>

<style>
  .exhibit {
    margin: 0;
    border-radius: 10px;
    overflow: hidden;
    background: #000;
    border: 1px solid var(--rule);
    box-shadow:
      0 30px 80px -30px rgba(0, 0, 0, 0.8),
      0 0 0 1px rgba(255, 255, 255, 0.02);
  }
  .chrome {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 0.9rem;
    background: var(--chrome);
    border-bottom: 1px solid var(--rule);
  }
  .dots {
    display: flex;
    gap: 6px;
  }
  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--ink) 22%, transparent);
  }
  .addr {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--muted);
    background: var(--bg);
    padding: 0.2rem 0.75rem;
    border-radius: 4px;
    flex: 1;
    max-width: 22rem;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .stage {
    position: relative;
    aspect-ratio: 16 / 10;
  }
  .stage :global(.slide) {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.9s ease;
  }
  .stage :global(.slide.on) {
    opacity: 1;
  }
  .pager {
    display: flex;
    gap: 6px;
    margin-left: auto;
  }
  .pip {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: color-mix(in srgb, var(--ink) 22%, transparent);
    cursor: pointer;
    transition:
      background-color 0.2s,
      width 0.2s;
  }
  .pip:hover {
    background: color-mix(in srgb, var(--ink) 45%, transparent);
  }
  .pip.on {
    width: 20px;
    border-radius: 4px;
    background: var(--accent);
  }
  .stage :global(picture) {
    display: block;
    height: 100%;
  }
  .stage :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .stage :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    background: #000;
  }
  /* A normal button beneath the screenshot, never on top of it. */
  .play {
    display: inline-flex;
    align-items: center;
    margin-top: 1.1rem;
    gap: 0.6rem;
    font: 600 0.98rem var(--body);
    color: var(--on-accent);
    background: var(--accent);
    border: 0;
    padding: 0.75rem 1.2rem;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.15s ease;
  }
  .play:hover {
    background: var(--ink);
  }
  .play[hidden] {
    display: none;
  }
  .tri {
    width: 0;
    height: 0;
    border-left: 9px solid var(--on-accent);
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
  }
  .exhibit.live .stage {
    aspect-ratio: auto;
    height: min(82vh, 860px);
  }
</style>
