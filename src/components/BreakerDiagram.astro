---
// AdventureBreaker, one probe played out: walk the spine (Zork I's walkthrough, 387 steps), save, attack the state,
// push the reply through the free deterministic checks before the LLM critic, and log what it finds. The finding is
// the real AB-001: the narrator invented a broom, fixed in ZorkAI PR #234. At rest it shows the finished probe.
const steps = 30;
const here = 7;
const dotX = (k: number) => 48 + k * 24.25;
const layers = [
  { name: 'L0 contract', what: 'Free. Errors, malformed JSON, leaked internals.', result: 'pass' },
  { name: 'L1 consistency', what: 'Free. The prose against the state: moves, score, inventory.', result: 'pass' },
  { name: 'L2 anchors', what: 'Free. Character breaks, and the golden transcript.', result: 'pass' },
  { name: 'L3 critic', what: 'An AI judge. Hallucinations, lore, spoilers, injection.', result: 'invented object', fail: true },
];
const rowY = (i: number) => 216 + i * 50;
const mid = (i: number) => rowY(i) + 25;
// The flow runs down the left edge: blue from the attack to the critic, red from the critic to the ledger.
const top = 127;
const critic = mid(3);
const bottom = 466;
const at = (y: number) => ((y - top) / (critic - top)).toFixed(3);
---

<svg
  class="probe"
  viewBox="0 0 800 500"
  role="img"
  aria-label="AdventureBreaker walks Zork I's walkthrough, step 8 of 387, saves, and attacks: examine the wizard standing in the corner. The narrator's reply mentions a paint-splattered broom. The reply passes the free checks, L0 contract, L1 consistency and L2 anchors, and the L3 critic flags an invented object. It's logged as AB-001 and was fixed in ZorkAI pull request 234."
>
  <text x="48" y="50" class="tag">ZORK I · THE SPINE · STEP <tspan class="step">{here + 1}</tspan> OF 387</text>
  <text x="752" y="50" class="tag phase"></text>

  <!-- The spine: the walkthrough, one dot per step; the trail is how far it has walked. -->
  <line x1={dotX(0)} x2={dotX(here)} y1="78" y2="78" class="trail"></line>
  {Array.from({ length: steps }, (_, k) => <circle cx={dotX(k)} cy="78" r="3" class:list={['dot', { walked: k <= here }]} data-k={k} />)}
  <circle cx={dotX(here)} cy="78" r="8" class="marker" data-x={dotX(here)} data-step={dotX(1) - dotX(0)}></circle>
  <line x1={dotX(here)} x2={dotX(here)} y1="88" y2="100" class="tick"></line>
  <text x={dotX(here) + 8} y="100" class="tick-label">save</text>

  <!-- The attack, and what the narrator said. -->
  <circle cx="56" cy={top} r="4" class="start-dot"></circle>
  <text x="72" y="133" class="attack">&gt; examine the wizard standing in the corner</text>
  <text x="72" y="163" class="narr"><tspan class="narr-tag">NARRATOR</tspan>   “… a paint-splattered broom …”</text>

  <text x="72" y="204" class="tag">FOUR CHECKS, CHEAPEST FIRST</text>
  <text x="752" y="204" class="tag end">VERDICT</text>
  {
    layers.map((l, i) => (
      <g class:list={['layer', { fail: l.fail }]} data-at={at(mid(i))}>
        <line x1="48" x2="752" y1={rowY(i)} y2={rowY(i)} class="rule" />
        <circle cx="56" cy={mid(i)} r="4" class="check" />
        <text x="72" y={rowY(i) + 22} class="lname">{l.name}</text>
        <text x="72" y={rowY(i) + 39} class="lwhat">{l.what}</text>
        <text x="752" y={rowY(i) + 29} class="lres">{l.result}</text>
      </g>
    ))
  }
  <line x1="48" x2="752" y1={rowY(4)} y2={rowY(4)} class="rule" />

  <path d={`M56 ${top} V${critic}`} class="flow" pathLength="1"></path>
  <path d={`M56 ${critic} V${bottom}`} class="flow bug" pathLength="1"></path>
  <circle cx="56" cy={bottom} r="4" class="ledger-dot"></circle>

  <text x="72" y="446" class="tag ledger-tag">FINDINGS LEDGER</text>
  <text x="72" y="471" class="finding"><tspan class="fid">AB-001</tspan>   Narrator invents a broom that isn’t there</text>
  <text x="752" y="471" class="status">fixed · PR #234</text>
</svg>

<script>
  // Plays the probe on a loop while it's on screen. Every step adds a class or rewrites a little text; CSS does the rest.
  import { loopWhileVisible, say, sleep, type } from '../scripts/play';

  for (const svg of document.querySelectorAll<SVGSVGElement>('svg.probe')) {
    const $ = (s: string) => svg.querySelector(s)!;
    const phase = $('.phase');
    const step = $('.step');
    const marker = $('.marker') as SVGCircleElement;
    const trail = $('.trail') as SVGLineElement;
    const tickLabel = $('.tick-label');
    const dots = [...svg.querySelectorAll<SVGCircleElement>('.dot.walked')];
    const layers = [...svg.querySelectorAll<SVGGElement>('.layer')];
    const flow = $('.flow:not(.bug)') as SVGPathElement;
    const bug = $('.flow.bug') as SVGPathElement;
    const attack = $('.attack');
    const status = $('.status');
    const attackText = attack.textContent ?? '';
    const pitch = Number(marker.dataset.step);
    const here = dots.length - 1;
    const moveTo = (k: number) => {
      marker.style.transform = `translateX(${(k - here) * pitch}px)`;
      trail.style.transform = `scaleX(${k / here})`;
    };
    const draw = (path: SVGPathElement, f: number, instant = false) => {
      if (instant) path.style.transition = 'none';
      path.style.strokeDashoffset = String(1 - f);
      if (instant) {
        path.getBoundingClientRect();
        path.style.transition = '';
      }
    };

    loopWhileVisible(svg, async () => {
      // Reset to the start of the walkthrough.
      svg.classList.remove('fade');
      svg.querySelectorAll('.on, .done').forEach((el) => el.classList.remove('on', 'done'));
      attack.textContent = '';
      status.textContent = 'open';
      tickLabel.textContent = 'save';
      draw(flow, 0, true);
      draw(bug, 0, true);
      moveTo(0);
      step.textContent = '1';
      await sleep(400);

      await say(phase, 'Walking the spine');
      marker.classList.add('on');
      for (const [k, d] of dots.entries()) {
        d.classList.add('on');
        moveTo(k);
        step.textContent = String(k + 1);
        await sleep(260);
      }
      await sleep(300);

      await say(phase, 'Save, then attack');
      $('.tick').classList.add('on');
      tickLabel.classList.add('on');
      await sleep(400);
      $('.start-dot').classList.add('on');
      attack.classList.add('on');
      await type(attack, attackText, 30);
      await sleep(400);

      await say(phase, 'The narrator answers');
      $('.narr').classList.add('on');
      await sleep(1200);

      await say(phase, 'Cheapest checks first');
      for (const l of layers) {
        draw(flow, Number(l.dataset.at));
        await sleep(350);
        l.classList.add('on');
        if (l.classList.contains('fail')) break;
        await sleep(250);
        l.classList.add('done');
        await sleep(300);
      }

      await say(phase, 'The critic judges');
      await sleep(900);
      layers.at(-1)!.classList.add('done');
      await sleep(900);

      await say(phase, 'Logged, filed, fixed');
      draw(bug, 1);
      await sleep(450);
      $('.ledger-dot').classList.add('on');
      $('.ledger-tag').classList.add('on');
      $('.finding').classList.add('on');
      status.classList.add('on');
      await sleep(900);
      status.classList.remove('on');
      await sleep(250);
      status.textContent = 'fixed · PR #234';
      status.classList.add('on', 'done');
      await sleep(1300);

      await say(phase, 'Restore, and walk on');
      tickLabel.classList.remove('on');
      await sleep(200);
      tickLabel.textContent = 'restore';
      tickLabel.classList.add('on');
      await sleep(700);
      $('.tick').classList.remove('on');
      tickLabel.classList.remove('on');
      moveTo(here + 1);
      step.textContent = String(here + 2);
      await sleep(3000);

      svg.classList.add('fade');
      await sleep(700);
    });
  }
</script>

<style>
  .probe {
    width: 100%;
    height: 100%;
    display: block;
    background: var(--bg-2);
    font-family: var(--mono);
  }
  .tag {
    fill: var(--muted);
    font-size: 11px;
    letter-spacing: 0.12em;
  }
  .end,
  .lres,
  .status,
  .phase {
    text-anchor: end;
  }
  .phase {
    fill: var(--accent);
    letter-spacing: 0.04em;
  }

  /* The spine. */
  .trail {
    stroke: var(--ink);
    stroke-width: 1.5;
  }
  .dot {
    fill: color-mix(in srgb, var(--ink) 18%, transparent);
  }
  .dot.walked {
    fill: var(--ink);
  }
  .marker {
    fill: var(--bg-2);
    fill-opacity: 0;
    stroke: var(--accent);
    stroke-width: 2;
  }
  .tick {
    stroke: var(--accent-2);
    stroke-width: 1.5;
  }
  .tick-label {
    fill: var(--accent-2);
    font-size: 10.5px;
    letter-spacing: 0.06em;
  }

  /* The attack. */
  .attack {
    fill: var(--ink);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .narr {
    font-family: var(--body);
    font-size: 16px;
    font-style: italic;
    fill: var(--ink-2);
    white-space: pre;
  }
  .narr-tag {
    font-family: var(--mono);
    font-style: normal;
    font-size: 11px;
    letter-spacing: 0.12em;
    fill: var(--muted);
  }

  /* The checks. */
  .rule {
    stroke: var(--rule);
  }
  .check,
  .start-dot {
    fill: var(--accent);
  }
  .lname {
    fill: var(--ink);
    font-size: 14px;
    font-weight: 600;
  }
  .lwhat {
    font-family: var(--body);
    fill: var(--muted);
    font-size: 12px;
  }
  .lres {
    fill: var(--accent);
    font-size: 14px;
  }
  .fail .check,
  .ledger-dot,
  .fid {
    fill: var(--accent-2);
  }
  .fail .lname,
  .fail .lres {
    fill: var(--accent-2);
  }
  .fail .lres {
    font-weight: 600;
  }
  .flow {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
  }
  .flow.bug {
    stroke: var(--accent-2);
  }

  /* The ledger. */
  .finding {
    fill: var(--ink);
    font-size: 14px;
    white-space: pre;
  }
  .fid {
    font-weight: 700;
  }
  .status {
    fill: var(--accent);
    font-size: 14px;
    font-weight: 700;
  }

  /* Playing: each step turns its piece on. */
  .live :is(.marker, .tick, .tick-label, .attack, .narr, .layer, .start-dot, .ledger-dot, .ledger-tag, .finding, .status, .phase) {
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .live .on {
    opacity: 1;
  }
  .live .dot.walked {
    fill: color-mix(in srgb, var(--ink) 18%, transparent);
    transition: fill 0.25s;
  }
  .live .dot.walked.on {
    fill: var(--ink);
  }
  .live .trail {
    transform-box: fill-box;
    transform-origin: left;
    transition: transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .live .marker {
    transition:
      opacity 0.3s,
      transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .live .tick {
    transform-box: fill-box;
    transform-origin: top;
    transform: scaleY(0);
    transition:
      opacity 0.2s,
      transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .live .tick.on {
    transform: none;
  }
  .live .layer {
    transform: translateY(6px);
    transition:
      opacity 0.4s ease,
      transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .live .layer.on {
    transform: none;
  }
  /* A check's verdict lands a beat after the reply reaches it. */
  .live .layer :is(.lres, .check) {
    opacity: 0;
    transition: opacity 0.25s;
  }
  .live .layer.done :is(.lres, .check) {
    opacity: 1;
  }
  .live .fail:not(.done) .lname {
    fill: var(--ink);
  }
  .live .fail .lname {
    transition: fill 0.3s;
  }
  .live .flow {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.4s cubic-bezier(0.4, 0, 0.3, 1);
  }
  .live .status {
    fill: var(--muted);
  }
  .live .status.done {
    fill: var(--accent);
  }
  .live.fade :is(.dot, .trail, .marker, .tick, .tick-label, .attack, .narr, .layer, .start-dot, .ledger-dot, .ledger-tag, .finding, .status, .phase, .flow) {
    opacity: 0;
    transition: opacity 0.6s ease;
  }
</style>
