---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Michael Lane: engineering leader, VP of Engineering, building with AI since before it was called that.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,400..800;1,400..800&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header wrap">
      <a href="/" class="wordmark">Michael Lane</a>
      <nav>
        <a href="/#work">Work</a>
        <a href="/#exhibits">Exhibits</a>
        <a href="/resume">Résumé</a>
        <a href="/#contact">Contact</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer wrap">
      <p>
        Built with <a href="/how-this-was-built">Claude Code</a>, Astro and an unreasonable attachment to 1980s text
        adventures. <a href="https://github.com/arsindelve/michaellane.ai">Source</a>.
      </p>
    </footer>
  </body>
</html>
