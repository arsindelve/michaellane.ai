---
import '../styles/global.css';
import '../styles/mockups.css';
import '../styles/obsidian.css';
import '../styles/home-load.css';
import FooterMocks from '../components/FooterMocks.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Michael Lane: Engineering leader, building with AI.',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-style="obsidian" data-bg="waves" data-btn="f" data-play="1" data-ex="d" data-footer="c">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,400..800;1,400..800&family=IBM+Plex+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@400..800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Style mockups: ?style=poster|museum|blueprint (remembered per browser). Removed once one is chosen.
      try {
        // Rooms + waves are the design now; ?style= only previews other mockups and is not remembered.
        localStorage.removeItem('style');
        const s = new URLSearchParams(location.search).get('style');
        if (s) document.documentElement.dataset.style = s;
        const cd = new URLSearchParams(location.search).get('code');
        if (cd) document.documentElement.dataset.code = cd;
        const ft = new URLSearchParams(location.search).get('footer');
        if (ft) document.documentElement.dataset.footer = ft;
        const bt = new URLSearchParams(location.search).get('btn');
        if (bt) document.documentElement.dataset.btn = bt;
        const ex = new URLSearchParams(location.search).get('ex');
        if (ex) document.documentElement.dataset.ex = ex;
        const pl = new URLSearchParams(location.search).get('play');
        if (pl) document.documentElement.dataset.play = pl;
        const bg = new URLSearchParams(location.search).get('bg');
        if (bg) document.documentElement.dataset.bg = bg;
        const f = new URLSearchParams(location.search).get('flourish');
        if (f) document.documentElement.dataset.flourish = f;
      } catch {}
    </script>
  </head>
  <body>
    <header class="site-header wrap">
      <a href="/" class="wordmark">Michael Lane</a>
      <nav>
        <a href="/#work">Work</a>
        <a href="/#exhibits">Exhibits</a>
        <a href="/resume">Résumé</a>
        <a href="/contact">Contact</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer wrap">
      <p>
        Built with <a href="/how-this-was-built">Claude Code</a>, Gemini, Astro and an unreasonable attachment to 1980s text
        adventures. <a href="https://github.com/arsindelve/michaellane.ai">Source</a>.
      </p>
    </footer>
    <FooterMocks />
    <script>
      // Mockup motion. Content is always visible at rest; motion only settles it into place.
      const root = document.documentElement;
      if (root.dataset.style && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('in');
              io.unobserve(e.target);
              for (const big of e.target.querySelectorAll<HTMLElement>('.card .big')) {
                const node = big.firstChild;
                const m = node?.textContent?.match(/^(\D*)(\d+)(.*)$/s);
                if (!node || !m) continue;
                const [, pre, num, post] = m;
                const end = Number(num);
                const t0 = performance.now();
                const tick = (t: number) => {
                  const k = Math.min(1, (t - t0) / 1100);
                  node.textContent = pre + Math.round(end * (1 - Math.pow(1 - k, 3))) + post;
                  if (k < 1) requestAnimationFrame(tick);
                };
                requestAnimationFrame(tick);
              }
            }
          },
          { threshold: 0.15 },
        );
        root.classList.add('motion');
        for (const el of document.querySelectorAll('.shift, .work, .edu, .ex, .coda, .contact, .room-sep')) io.observe(el);
      }
      // Stacked-deck exhibit mockups. Each card sticks 12px below the last (or, if it's taller than the screen, once
      // it has fully scrolled in). Cards keep their own heights, so a covered card is trimmed to what should show:
      // nothing below the card on top of it, and only a 12px edge above it once that card has stuck.
      if (['b', 'd', 'f'].includes(root.dataset.ex ?? '')) {
        const cards = [...document.querySelectorAll<HTMLElement>('.exhibits .ex')];
        const tops: number[] = [];
        const fit = () => {
          // Cards stack just below the pinned section title.
          const head = document.querySelector<HTMLElement>('.exhibits .ex-head');
          const base = (head && getComputedStyle(head).position === 'sticky' ? head.offsetHeight : 64) + 16;
          document.documentElement.style.setProperty('--head', `${base - 16}px`);
          // Each card fills the screen below the title, leaving room for the stack's edges, up to a comfortable cap.
          const room = Math.min(innerHeight - base - 24 - (cards.length - 1) * 12, 860);
          cards.forEach((el) => (el.style.minHeight = innerWidth > 960 ? `${room}px` : ''));
          cards.forEach((el, i) => {
            // Never above the pinned title; a card too tall to fit sticks there and its bottom scrolls past.
            tops[i] = Math.max(base, Math.min(base + i * 12, innerHeight - el.offsetHeight - 24));
            el.style.setProperty('--top', `${tops[i]}px`);
          });
          trim();
        };
        const trim = () => {
          const r = cards.map((el) => el.getBoundingClientRect());
          let below = Infinity;
          for (let i = cards.length - 1; i >= 0; i--) {
            const next = r[i + 1];
            let cutTop = 0;
            let cutBottom = 0;
            if (next && next.top < r[i].bottom) {
              below = Math.min(below, next.bottom);
              cutBottom = Math.max(0, r[i].bottom - below);
              if (next.top <= tops[i + 1] + 1) {
                // Show only the card's own top edge; if that edge is off-screen, hide the card altogether.
                cutTop = r[i].top < next.top - 24 ? r[i].height : Math.max(0, next.top - 12 - r[i].top);
              }
            } else {
              below = Infinity;
            }
            cards[i].style.clipPath = cutTop || cutBottom ? `inset(${cutTop}px 0 ${cutBottom}px 0 round 22px)` : '';
            below = Math.min(below, r[i].bottom);
          }
        };
        fit();
        addEventListener('resize', fit);
        addEventListener('load', fit);
        addEventListener('scroll', () => requestAnimationFrame(trim), { passive: true });
      }
      // Path-rail exhibit mockups: a numbered rail beside the deck that lights up as each card arrives.
      if (['d', 'f'].includes(root.dataset.ex ?? '')) {
        const hall = document.querySelector('.exhibits');
        const cards = [...document.querySelectorAll<HTMLElement>('.exhibits .ex')];
        if (hall && cards.length) {
          const rail = document.createElement('ol');
          rail.className = 'ex-rail';
          rail.setAttribute('aria-hidden', 'true');
          cards.forEach((card, i) => {
            const li = document.createElement('li');
            li.dataset.n = String(i + 1).padStart(2, '0');
            li.title = card.querySelector('h2')?.textContent ?? '';
            li.addEventListener('click', () => card.scrollIntoView({ behavior: 'smooth' }));
            rail.append(li);
          });
          hall.querySelector('.ex-head')?.after(rail);
          const items = [...rail.children];
          let ticking = false;
          const update = () => {
            ticking = false;
            let at = 0;
            cards.forEach((c, i) => {
              if (c.getBoundingClientRect().top < innerHeight * 0.5) at = i;
            });
            items.forEach((li, i) => {
              li.classList.toggle('on', i === at);
              li.classList.toggle('done', i < at);
            });
            rail.style.setProperty('--p', String(at / (cards.length - 1)));
          };
          addEventListener(
            'scroll',
            () => {
              if (ticking) return;
              ticking = true;
              requestAnimationFrame(update);
            },
            { passive: true },
          );
          update();
        }
      }
      // Transcript mockup: the status line shows the room you're in.
      if (root.dataset.style === 'transcript') {
        const loc = document.querySelector('.sl-loc');
        const where = new IntersectionObserver(
          (entries) => {
            for (const e of entries) if (e.isIntersecting && loc) loc.textContent = (e.target as HTMLElement).dataset.room ?? '';
          },
          { rootMargin: '-40% 0px -55% 0px' },
        );
        for (const el of document.querySelectorAll('[data-room]:not(.room-sep)')) where.observe(el);
      }
    </script>
  </body>
</html>
